<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>生活管家・一鍵倒垃圾雷達</title>
  <meta name="theme-color" content="#10B981">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <!-- LINE LIFF 官方 SDK (生活管家雙模引擎) -->
  <script charset="utf-8" src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
  <style>
    :root {
      --primary: #059669;
      --primary-light: #D1FAE5;
      --primary-dark: #065F46;
      --accent-orange: #EA580C;
      --accent-orange-bg: #FFEDD5;
      --bg: #F8FAFC;
      --card-bg: #FFFFFF;
      --text-main: #0F172A;
      --text-sub: #334155;
      --text-muted: #64748B;
      --border: #E2E8F0;
      --danger: #DC2626;
      --danger-bg: #FEE2E2;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans TC", sans-serif;
    }

    body {
      background-color: var(--bg);
      color: var(--text-main);
      padding: 16px;
      padding-bottom: 80px;
      display: flex;
      justify-content: center;
      -webkit-font-smoothing: antialiased;
    }

    .app-container {
      width: 100%;
      max-width: 480px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* 頂部生活管家標頭 - 包浩斯深邃漸層與雷達儀表板 */
    .header-card {
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
      color: #FFFFFF;
      padding: 22px 20px;
      border-radius: 24px;
      box-shadow: 0 12px 28px -6px rgba(5, 150, 105, 0.35);
      display: flex;
      flex-direction: column;
      gap: 10px;
      position: relative;
      overflow: hidden;
    }

    .header-card::after {
      content: '';
      position: absolute;
      top: -50px;
      right: -50px;
      width: 140px;
      height: 140px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 70%);
      pointer-events: none;
    }

    .radar-status-bar {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(0, 0, 0, 0.16);
      padding: 5px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      color: #ECFDF5;
      width: fit-content;
      backdrop-filter: blur(4px);
    }

    .radar-pulse-dot {
      width: 8px;
      height: 8px;
      background-color: #34D399;
      border-radius: 50%;
      position: relative;
      flex-shrink: 0;
    }

    .radar-pulse-dot::after {
      content: '';
      position: absolute;
      top: -4px;
      left: -4px;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background-color: rgba(52, 211, 153, 0.5);
      animation: radarRing 1.8s infinite;
    }

    @keyframes radarRing {
      0% { transform: scale(0.6); opacity: 1; }
      100% { transform: scale(1.8); opacity: 0; }
    }

    .header-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255, 255, 255, 0.2);
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      width: fit-content;
      backdrop-filter: blur(4px);
    }

    .header-title {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -0.5px;
    }

    .header-sub {
      font-size: 14px;
      opacity: 0.95;
      line-height: 1.4;
    }

    /* 核心操作主盒：去粗邊框，改採光階漫射投影 (約瑟夫美學) */
    .control-card {
      background: #FFFFFF;
      border: 1px solid rgba(226, 232, 240, 0.8);
      border-radius: 20px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.04), 0 4px 6px -2px rgba(15, 23, 42, 0.02);
    }

    /* 一鍵定位大按鈕 */
    .gps-btn {
      background-color: #FFFFFF;
      color: var(--primary-dark);
      border: 2px solid #A7F3D0;
      padding: 14px 18px;
      border-radius: 16px;
      font-size: 16px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      transition: all 0.2s ease;
    }

    .gps-btn:active {
      transform: scale(0.98);
      background-color: var(--primary-light);
    }

    /* 快速生活圈選擇器 (若未開啟 GPS 容錯) */
    .area-selector {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 4px;
      scrollbar-width: none;
    }
    .area-selector::-webkit-scrollbar { display: none; }

    .area-chip {
      flex-shrink: 0;
      background-color: #FFFFFF;
      border: 1px solid var(--border);
      padding: 8px 14px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 600;
      color: var(--text-sub);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .area-chip.active {
      background-color: var(--primary);
      color: #FFFFFF;
      border-color: var(--primary);
      box-shadow: 0 2px 6px rgba(5, 150, 105, 0.25);
    }

    /* 狀態提示 (停收日 / 離線模式) */
    .alert-banner {
      padding: 14px 16px;
      border-radius: 14px;
      font-size: 14px;
      font-weight: 600;
      line-height: 1.4;
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    .alert-danger {
      background-color: var(--danger-bg);
      color: var(--danger);
      border: 1px solid #FECACA;
    }

    .alert-info {
      background-color: #EFF6FF;
      color: #1D4ED8;
      border: 1px solid #BFDBFE;
    }

    /* 交通工具切換器 - 磁吸控制台 (約瑟夫升級款) */
    .travel-track {
      display: flex;
      background: #F1F5F9;
      border-radius: 16px;
      padding: 5px;
      gap: 6px;
    }

    .travel-chip {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 10px 8px;
      border-radius: 12px;
      background: transparent;
      border: 1px solid transparent;
      cursor: pointer;
      color: var(--text-sub);
      font-size: 14px;
      font-weight: 700;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .travel-chip.active {
      background: #FFFFFF;
      color: #065F46;
      border-color: rgba(5, 150, 105, 0.2);
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
      font-weight: 900;
      transform: translateY(-1px);
    }

    /* 核心決策卡片 - 約瑟夫極致光學版 */
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 20px;
      box-shadow: 0 8px 20px -4px rgba(15, 23, 42, 0.04), 0 4px 6px -2px rgba(15, 23, 42, 0.02);
      display: flex;
      flex-direction: column;
      gap: 14px;
      position: relative;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card-fastest {
      border: 2px solid #EF4444;
      background: #FFFFFF;
      box-shadow: 0 16px 36px -8px rgba(220, 38, 38, 0.22), 0 4px 12px rgba(220, 38, 38, 0.08);
      overflow: hidden;
      padding: 0;
    }

    .card-fastest-banner {
      background: linear-gradient(135deg, #DC2626 0%, #991B1B 100%);
      color: #FFFFFF;
      padding: 14px 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .card-fastest-content {
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .card-tag {
      align-self: flex-start;
      padding: 4px 10px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.5px;
    }

    .tag-fastest {
      background-color: #DC2626;
      color: #FFFFFF;
      box-shadow: 0 2px 6px rgba(220, 38, 38, 0.3);
    }

    .tag-nearest {
      background-color: #0284C7;
      color: #FFFFFF;
      box-shadow: 0 2px 6px rgba(2, 132, 199, 0.3);
    }

    .tag-fixed {
      background-color: #D97706;
      color: #FFFFFF;
      box-shadow: 0 2px 6px rgba(217, 119, 6, 0.3);
    }

    .card-title-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
    }

    .stop-name {
      font-size: 19px;
      font-weight: 800;
      color: var(--text-main);
      line-height: 1.3;
      letter-spacing: -0.3px;
    }

    .countdown-pill {
      background: #DC2626;
      color: #FFFFFF;
      font-size: 13px;
      font-weight: 800;
      padding: 5px 12px;
      border-radius: 999px;
      animation: pulse 1.6s infinite;
      white-space: nowrap;
      box-shadow: 0 2px 8px rgba(220, 38, 38, 0.35);
    }

    @keyframes pulse {
      0% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.88; transform: scale(1.03); }
      100% { opacity: 1; transform: scale(1); }
    }

    /* 光學時間軸步進器 (約瑟夫三點一線節奏軸) */
    .stepper-container {
      background: #FFF1F2;
      border: 1px solid #FECDD3;
      border-radius: 14px;
      padding: 12px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }

    .stepper-node {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      flex: 1;
    }

    .stepper-time {
      font-size: 14px;
      font-weight: 800;
      color: #9F1239;
      letter-spacing: -0.3px;
    }

    .stepper-label {
      font-size: 11px;
      font-weight: 700;
      color: #BE123C;
      opacity: 0.9;
    }

    .stepper-arrow {
      display: flex;
      flex-direction: column;
      align-items: center;
      font-size: 11px;
      font-weight: 800;
      color: #E11D48;
      flex-shrink: 0;
      line-height: 1.2;
    }

    .card-meta-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      background: rgba(255, 255, 255, 0.9);
      padding: 12px;
      border-radius: 14px;
      border: 1px solid rgba(0, 0, 0, 0.05);
    }
      font-weight: 800;
      letter-spacing: 0.5px;
    }

    .tag-fastest {
      background-color: #DC2626;
      color: #FFFFFF;
    }

    .tag-nearest {
      background-color: #0284C7;
      color: #FFFFFF;
    }

    .tag-fixed {
      background-color: #D97706;
      color: #FFFFFF;
    }

    .card-title-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .stop-name {
      font-size: 18px;
      font-weight: 800;
      color: var(--text-main);
      line-height: 1.3;
    }

    .countdown-pill {
      background: #DC2626;
      color: #FFFFFF;
      font-size: 13px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 999px;
      animation: pulse 1.5s infinite;
      white-space: nowrap;
    }

    @keyframes pulse {
      0% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.85; transform: scale(1.03); }
      100% { opacity: 1; transform: scale(1); }
    }

    .card-meta-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      background: rgba(255, 255, 255, 0.8);
      padding: 10px;
      border-radius: 12px;
      border: 1px solid rgba(0, 0, 0, 0.04);
    }

    .meta-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .meta-label {
      font-size: 12px;
      color: var(--text-sub);
    }

    .meta-val {
      font-size: 15px;
      font-weight: 700;
      color: var(--text-main);
    }

    /* 一鍵導航按鈕 (48px 高，長輩大拇指防呆) */
    .nav-btn {
      background-color: var(--primary);
      color: #FFFFFF;
      text-decoration: none;
      padding: 13px;
      border-radius: 14px;
      font-size: 15px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      min-height: 48px;
      box-shadow: 0 3px 8px rgba(5, 150, 105, 0.25);
    }

    .nav-btn:active {
      background-color: var(--primary-dark);
      transform: scale(0.99);
    }

    .nav-btn.nav-btn-fastest {
      background-color: #DC2626;
      box-shadow: 0 4px 12px rgba(220, 38, 38, 0.35);
    }

    .nav-btn.nav-btn-fastest:active {
      background-color: #B91C1C;
    }

    .nav-btn.secondary {
      background-color: #F1F5F9;
      color: #334155;
      box-shadow: none;
    }

    /* 商業導流轉化卡 (生活管家 999 包月) */
    .upsell-card {
      background: linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%);
      border: 2px dashed #FB923C;
      border-radius: 18px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .upsell-badge {
      color: #C2410C;
      font-size: 12px;
      font-weight: 800;
    }

    .upsell-title {
      font-size: 17px;
      font-weight: 800;
      color: #9A3412;
      line-height: 1.3;
    }

    .upsell-desc {
      font-size: 13px;
      color: #7C2D12;
      line-height: 1.5;
    }

    .upsell-btn {
      background: #EA580C;
      color: #FFFFFF;
      text-decoration: none;
      padding: 13px;
      border-radius: 12px;
      font-size: 15px;
      font-weight: 700;
      text-align: center;
      box-shadow: 0 3px 8px rgba(234, 88, 12, 0.3);
    }

    .upsell-btn:active {
      background: #C2410C;
    }

    /* 頁尾小字 */
    .footer-note {
      text-align: center;
      font-size: 12px;
      color: #94A3B8;
      line-height: 1.5;
      margin-top: 10px;
    }
  </style>
</head>
<body>

  <div class="app-container">

    <!-- 頂部生活管家標頭 - 包浩斯深邃漸層與雷達儀表板 -->
    <header class="header-card">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div class="radar-status-bar">
          <span class="radar-pulse-dot"></span>
          <span id="userDisplayName" style="display:none; margin-right: 2px; font-weight:800; color: #FDE047;"></span>
          <span>台東即時清運雷達已在線</span>
        </div>
        <div class="header-badge" style="background: rgba(0,0,0,0.18);">
          <span>⏱️</span>
          <span id="liveClock">--:--</span>
        </div>
      </div>
      <h1 class="header-title" style="display: flex; align-items: center; gap: 8px;">
        <span>一鍵倒垃圾雷達</span>
        <span style="font-size: 12px; background: rgba(255,255,255,0.25); padding: 3px 8px; border-radius: 8px; font-weight: 800; letter-spacing: 0.5px;">PRO</span>
      </h1>
      <p class="header-sub">秒查離你最近、最快出門的垃圾車，不再慌張追車！</p>
    </header>

    <!-- 核心操作盒：去粗邊框，改採光階漫射投影 (約瑟夫美學) -->
    <section class="control-card">
      
      <!-- 定位方式雙軌選擇：【🎯 自動定位】 vs 【✏️ 手動輸入地址】 (創辦人指定雙軌) -->
      <div style="display: flex; flex-direction: column; gap: 8px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
        <div style="display: flex; gap: 6px;">
          <button id="tabGpsBtn" onclick="switchLocMode('gps')" class="area-chip active" style="flex: 1; text-align: center; font-size: 14px; padding: 10px; font-weight: 800;">
            🎯 手機自動定位
          </button>
          <button id="tabManualBtn" onclick="switchLocMode('manual')" class="area-chip" style="flex: 1; text-align: center; font-size: 14px; padding: 10px; font-weight: 800;">
            ✏️ 手動輸入地址
          </button>
        </div>

        <!-- 模式 A：GPS 自動定位狀態列 -->
        <div id="gpsView" style="display: flex; justify-content: space-between; align-items: center; background: #F8FAFC; padding: 10px 12px; border-radius: 12px;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 18px;">📍</span>
            <div>
              <div style="font-size: 11px; color: var(--text-sub); font-weight: 600;">出發點 (手機 GPS)</div>
              <div id="currentLocationText" style="font-size: 14px; font-weight: 800; color: var(--text-main);">正在抓取手機 GPS...</div>
            </div>
          </div>
          <button id="gpsTriggerBtn" onclick="requestLocation()" style="background: var(--primary-light); color: var(--primary-dark); border: 1px solid #A7F3D0; padding: 6px 12px; border-radius: 999px; font-size: 12px; font-weight: 700; cursor: pointer;">
            🔄 刷新定位
          </button>
        </div>

        <!-- 模式 B：手動輸入地址/路名輸入框 -->
        <div id="manualView" style="display: none; flex-direction: column; gap: 6px;">
          <div style="display: flex; gap: 8px;">
            <input type="text" id="manualAddressInput" placeholder="輸入台東路名或地標 (如：寶桑路、正氣路)" onkeydown="if(event.key==='Enter') searchManualAddress()" style="flex: 1; height: 46px; font-size: 15px; font-weight: 700; background: #F8FAFC; border: 2px solid #CBD5E1; border-radius: 12px; padding: 0 12px; outline: none;">
            <button onclick="searchManualAddress()" style="height: 46px; padding: 0 16px; background: #059669; color: #FFFFFF; border: none; border-radius: 12px; font-size: 14px; font-weight: 700; cursor: pointer; white-space: nowrap;">
              🔍 定位
            </button>
          </div>
          <div id="manualSearchNotice" style="font-size: 11px; color: #059669; font-weight: 600;">
            💡 支援台東各路段：正氣路、中華路、更生路、傳廣路、四維路、寶桑路、鐵花路等
          </div>
        </div>
      </div>

      <!-- 倒垃圾時間自選與快捷鍵 -->
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <label for="trashTimeInput" style="font-size: 14px; font-weight: 800; color: var(--text-main);">
            ⏰ 您預計幾點去倒垃圾？
          </label>
          <span id="timeRelativeDesc" style="color: #059669; font-size: 13px; font-weight: 700;">(指定時間)</span>
        </div>
        
        <div style="display: flex; gap: 8px; align-items: center;">
          <input type="time" id="trashTimeInput" onchange="onTimeInputChange()" style="flex: 1; height: 50px; font-size: 22px; font-weight: 800; color: var(--text-main); background: #F8FAFC; border: 2px solid #CBD5E1; border-radius: 14px; padding: 0 14px; outline: none; text-align: center;">
          <button onclick="setNowTime()" style="height: 50px; padding: 0 16px; background: #059669; color: #FFFFFF; border: none; border-radius: 14px; font-size: 15px; font-weight: 700; white-space: nowrap; cursor: pointer; display: flex; align-items: center; gap: 4px;">
            ⚡ 就是現在
          </button>
        </div>

        <!-- 常用時段一鍵快捷切換 -->
        <div style="display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding-top: 4px;">
          <button class="area-chip" onclick="quickSetTime('16:45')">🕔 16:45</button>
          <button class="area-chip" onclick="quickSetTime('17:15')">🕠 17:15</button>
          <button class="area-chip" onclick="quickSetTime('18:00')">🕕 18:00</button>
          <button class="area-chip" onclick="quickSetTime('18:30')">🕡 18:30</button>
          <button class="area-chip" onclick="quickSetTime('19:00')">🕖 19:00</button>
        </div>

        <!-- 交通工具切換：【🚶 步行】 vs 【🛵 騎機車 (台東首選)】 vs 【🚗 開車】 (創辦人指引) -->
        <div style="display: flex; flex-direction: column; gap: 8px; padding-top: 4px;">
          <label style="font-size: 13px; font-weight: 800; color: var(--text-main); display: flex; justify-content: space-between; align-items: center;">
            <span>🛵 出門交通工具 (動態算路程)</span>
            <span id="travelModeDesc" style="color: #059669; font-weight: 800; font-size: 12px; background: #ECFDF5; padding: 2px 8px; border-radius: 6px;">(騎機車約 30km/h)</span>
          </label>
          <div class="travel-track">
            <button id="modeWalkBtn" onclick="setTravelMode('walking')" class="travel-chip area-chip">
              <span style="font-size: 16px;">🚶</span>
              <span>步行</span>
            </button>
            <button id="modeScooterBtn" onclick="setTravelMode('scooter')" class="travel-chip area-chip active">
              <span style="font-size: 16px;">🛵</span>
              <span>騎機車</span>
            </button>
            <button id="modeCarBtn" onclick="setTravelMode('car')" class="travel-chip area-chip">
              <span style="font-size: 16px;">🚗</span>
              <span>開車</span>
            </button>
          </div>
        </div>

        <!-- 資源回收勾選開關 (創辦人指示：默認只倒垃圾；勾選則強制匹配垃圾+回收雙收車) -->
        <div style="background: #F8FAFC; border: 2px solid #E2E8F0; border-radius: 14px; padding: 10px 14px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; transition: all 0.2s;" id="recycleBox" onclick="toggleRecycle(event)">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 22px;">♻️</span>
            <div>
              <div style="font-size: 14px; font-weight: 800; color: var(--text-main);" id="recycleTitleText">我也要倒「資源回收」</div>
              <div style="font-size: 11px; color: var(--text-sub);" id="recycleSubText">未勾選默認只倒垃圾；勾選後只顯示【垃圾+回收雙收】車次</div>
            </div>
          </div>
          <input type="checkbox" id="recycleCheckbox" onchange="onRecycleChange()" style="width: 22px; height: 22px; accent-color: #059669; cursor: pointer;">
        </div>
      </div>

    </section>

    <!-- 狀態警報 (例：台東在地週三/週日停收) -->
    <div id="alertContainer"></div>

    <!-- 決策卡片容器 -->
    <main id="cardsContainer" style="display: flex; flex-direction: column; gap: 14px;">
      <!-- 卡片內容將由 JavaScript 動態渲染 -->
    </main>

    <!-- 商業導流轉化卡 (生活管家 999/1999 包月真實登記入口) -->
    <section class="upsell-card" id="upsellCard">
      <div class="upsell-badge">💡 生活管家・台東到府代倒專案</div>
      <div class="upsell-title">追垃圾車好喘、下雨天又狼狽？</div>
      <div class="upsell-desc">
        這輩子，別再為了追垃圾車中斷晚餐狼狽衝刺了！<br>
        生活管家為您每週到府門前代收，一般垃圾 ＋ 資源回收一次搞定：<br>
        • <strong>999 輕量包</strong>：每週 2 次，適合小家庭與上班族<br>
        • <strong>1,999 旗艦包</strong>：每週 5 次（台東清潔隊收運日天天出勤）<br>
        🛵 專人到府人力代提 • 卸箱出勤100%食安隔離 • 門前保潔拍照回報
      </div>
      <a class="upsell-btn" href="https://docs.google.com/forms/d/e/1FAIpQLSchOskqPJfVtCVVEZpZuN2cHODjdAGSjyp184GkDpbFs-cqvw/viewform" target="_blank">
        👉 點我立即線上登記預約 (Google 表單)
      </a>
    </section>

    <footer class="footer-note">
      生活的一部分，就醬點！生活管家團隊 溫暖守護<br>
      資料來源：台東市清潔隊公開路線表 ✕ 清運e點通動態邏輯
    </footer>

  </div>

  <script>
    // ==========================================
    // 🛰️ 即時車機 GPS ✕ 動態 ETA 計算引擎 (PLAN-LB-TRASH-RADAR-01 修補版)
    // ==========================================
    let liveTrucksCache = {}; // { [normKey]: { car_no, name, run_id, lat, lon, speed, time, status, lastUpdate, visitedStops: {} } }
    let lastLiveFetchTimestamp = 0;
    let isFetchingLiveGps = false;

    // 第 8 項：統一車號格式（去掉括號備註、去掉「-」與空白、轉大寫）
    function normalizePlate(plateStr) {
      if (!plateStr) return "";
      return String(plateStr)
        .replace(/\(.*?\)/g, "")
        .replace(/（.*?）/g, "")
        .replace(/^回/, "")
        .replace(/[-\s]/g, "")
        .toUpperCase();
    }

    function makeStopKey(lat, lon) {
      return `${Number(lat).toFixed(5)},${Number(lon).toFixed(5)}`;
    }

    // 第 6 項：改用自家 Cloudflare Worker 為第一順位，公共代理保留為備援
    const CF_WORKER_URL = "https://taitung-trash-proxy.chalaw710218.workers.dev";
    const LIVE_GPS_PROXIES = [
      (target) => `${CF_WORKER_URL}/?url=${encodeURIComponent(target)}`,
      (target) => `https://api.allorigins.win/raw?url=${encodeURIComponent(target)}`,
      (target) => `https://corsproxy.io/?url=${encodeURIComponent(target)}`
    ];

    async function fetchLiveTruckLocations(forceByInterval = false) {
      const now = Date.now();
      // 45 秒防抖保護 (若為每 45 秒定時器觸發則允許執行)
      if ((!forceByInterval && now - lastLiveFetchTimestamp < 45000) || isFetchingLiveGps) {
        return;
      }
      isFetchingLiveGps = true;

      const targetUrl = "https://www.bstruck.hinet.net/MIS/subsystem/XML/Appcarlocation.ashx?customer_id=22&key=1";

      for (let i = 0; i < LIVE_GPS_PROXIES.length; i++) {
        try {
          const proxyUrl = LIVE_GPS_PROXIES[i](targetUrl);
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 6000);

          const res = await fetch(proxyUrl, { signal: controller.signal });
          clearTimeout(timeoutId);

          if (!res.ok) continue;
          const xmlText = await res.text();
          if (!xmlText || (!xmlText.includes("<Items>") && !xmlText.includes("<Items/>") && !xmlText.includes("<Items />"))) continue;

          // XML 解析
          const parser = new DOMParser();
          const xmlDoc = parser.parseFromString(xmlText, "text/xml");
          const carNodes = xmlDoc.getElementsByTagName("Car");

          const nextCache = { ...liveTrucksCache };
          for (let c = 0; c < carNodes.length; c++) {
            const node = carNodes[c];
            const rawCarNo = node.getAttribute("car_no") || "";
            const rawRouteName = node.getAttribute("name") || "";
            const runId = node.getAttribute("run_id") || "";
            const lat = parseFloat(node.getAttribute("lat"));
            const lon = parseFloat(node.getAttribute("lon"));
            const hasSpeedAttr = node.hasAttribute("speed");
            const status = node.getAttribute("car_status") || "執勤中";
            const speed = hasSpeedAttr ? parseFloat(node.getAttribute("speed") || "0") : (status === "執勤中" ? 15 : 0);
            const time = node.getAttribute("time") || "";

            if ((rawCarNo || rawRouteName) && !isNaN(lat) && !isNaN(lon)) {
              const normCar = normalizePlate(rawCarNo);
              const normRoute = normalizePlate(rawRouteName);
              const prevEntry = nextCache[normCar] || nextCache[normRoute] || nextCache[rawCarNo] || {};
              const visitedStops = { ...(prevEntry.visitedStops || {}) };

              // 第 1 項：檢查該車目前位置是否進入任何站點 120m 內，記錄於歷史欄位 visitedStops
              if (status !== "未執勤") {
                const allRoutes = (LOCAL_SEED_ROUTES || []).concat(RECYCLING_SEED_ROUTES || []);
                allRoutes.forEach(r => {
                  const rRunId = (r.run_id || (r.route_id || '').replace(/^TT_OFFICIAL_/, '').replace(/^TT_RECYCLE_/, ''));
                  if (normalizePlate(r.truck_plate) === normCar || normalizePlate(r.route_name) === normRoute || (runId && rRunId === runId)) {
                    (r.stops || []).forEach(st => {
                      if (haversine(lat, lon, st.lat, st.lon) <= 120) {
                        visitedStops[makeStopKey(st.lat, st.lon)] = true;
                      }
                    });
                  }
                });
              }

              const record = {
                car_no: rawCarNo,
                name: rawRouteName,
                run_id: runId,
                lat,
                lon,
                speed,
                time,
                status,
                lastUpdate: now,
                visitedStops
              };

              if (normCar) nextCache[normCar] = record;
              if (normRoute) nextCache[normRoute] = record;
              if (rawCarNo) nextCache[rawCarNo] = record;
              if (rawRouteName) nextCache[rawRouteName] = record;
              if (runId) {
                nextCache[runId] = record;
                nextCache['RUN_' + runId] = record;
              }
            }
          }

          liveTrucksCache = nextCache;
          lastLiveFetchTimestamp = now;
          isFetchingLiveGps = false;

          // 第 7 項：抓到即時車況後，只微更新徽章（不重繪整頁）
          updateCardsWithLiveStatus();
          return;
        } catch (e) {
          console.warn(`Live GPS fetch proxy [${i}] error:`, e.message);
        }
      }

      isFetchingLiveGps = false;
      lastLiveFetchTimestamp = now;
    }

    // 條目 11：清運e點通官方動態清運班表快取 (run_id -> { timestamp, stops: { [name or key]: { stime, rawStime, estimate, statusId, carNo } } })
    let liveRouteSchedules = {};
    const SCHEDULE_CACHE_TTL = 30000; // 30 秒快取
    let isFetchingSchedule = {};

    async function fetchRouteSchedule(runId) {
      if (!runId) return null;
      const now = Date.now();
      if (liveRouteSchedules[runId] && (now - liveRouteSchedules[runId].timestamp < SCHEDULE_CACHE_TTL)) {
        return liveRouteSchedules[runId];
      }
      if (isFetchingSchedule[runId]) return null;
      isFetchingSchedule[runId] = true;

      const proxyBase = "https://taitung-trash-proxy.chalaw710218.workers.dev";
      const proxyUrl = `${proxyBase}/schedule?run_id=${runId}`;

      try {
        const res = await fetch(proxyUrl);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const xmlText = await res.text();
        if (!xmlText || !xmlText.includes("<ScheduleTime")) {
          isFetchingSchedule[runId] = false;
          return null;
        }

        const parser = new DOMParser();
        const xmlDoc = parser.parseFromString(xmlText, "text/xml");
        const items = xmlDoc.getElementsByTagName("ScheduleTime");
        if (!items || items.length === 0) {
          isFetchingSchedule[runId] = false;
          return null;
        }

        const stopMap = {};
        let activeCarNo = "";
        for (let i = 0; i < items.length; i++) {
          const node = items[i];
          const name = (node.getAttribute("name") || "").trim();
          const stime = (node.getAttribute("stime") || "").trim();
          const estimate = (node.getAttribute("estimate") || "").trim();
          const statusId = (node.getAttribute("status_id") || "").trim();
          const carNo = (node.getAttribute("car_no") || "").trim();
          if (carNo && !activeCarNo) activeCarNo = carNo;
          const lat = parseFloat(node.getAttribute("lat"));
          const lon = parseFloat(node.getAttribute("lon"));

          let cleanStime = stime;
          if (stime.includes("~")) {
            cleanStime = stime.split("~")[0].trim();
          }

          const info = { name, stime: cleanStime, rawStime: stime, estimate, statusId, carNo, lat, lon };
          if (name) stopMap[name] = info;
          if (!isNaN(lat) && !isNaN(lon)) {
            stopMap[`${lat.toFixed(4)},${lon.toFixed(4)}`] = info;
            stopMap[`${lat},${lon}`] = info;
          }
        }

        liveRouteSchedules[runId] = {
          timestamp: now,
          activeCarNo: activeCarNo,
          stops: stopMap
        };

        // 動態自適應車牌綁定：若官方班表中帶有執勤車號，同步至路線與快取
        if (activeCarNo) {
          const normCar = normalizePlate(activeCarNo);
          if (liveTrucksCache && (liveTrucksCache[normCar] || liveTrucksCache[activeCarNo])) {
            const truck = liveTrucksCache[normCar] || liveTrucksCache[activeCarNo];
            liveTrucksCache[runId] = truck;
            liveTrucksCache['RUN_' + runId] = truck;
          }
          const allRoutes = (LOCAL_SEED_ROUTES || []).concat(RECYCLING_SEED_ROUTES || []);
          allRoutes.forEach(r => {
            const rRunId = (r.run_id || (r.route_id || '').replace(/^TT_OFFICIAL_/, '').replace(/^TT_RECYCLE_/, ''));
            if (rRunId === runId) {
              r.truck_plate = activeCarNo;
            }
          });
        }
        isFetchingSchedule[runId] = false;
        return liveRouteSchedules[runId];
      } catch (err) {
        console.warn(`Fetch schedule for run ${runId} error:`, err ? err.message : err);
        isFetchingSchedule[runId] = false;
        return null;
      }
    }

    // 第 1 項、第 8 項 & 第 11 項：計算特定車輛對特定站點的即時動態 ETA 與清運狀態
    
    // 依路線資訊（優先 runId，次以車號或路線名）精確查找當前車機
    function getLiveTruckForRoute(route) {
      if (!liveTrucksCache) return null;
      const runId = (route.run_id || (route.route_id || '').replace(/^TT_OFFICIAL_/, '').replace(/^TT_RECYCLE_/, ''));
      if (runId && (liveTrucksCache[runId] || liveTrucksCache['RUN_' + runId])) {
        return liveTrucksCache[runId] || liveTrucksCache['RUN_' + runId];
      }
      const normPlate = normalizePlate(route.truck_plate);
      const normRoute = normalizePlate(route.route_name);
      return liveTrucksCache[normPlate] || liveTrucksCache[normRoute] || liveTrucksCache[route.truck_plate] || null;
    }

    function evaluateLiveTruckStatus(plate, stopLat, stopLon, stopMin, runId, stopName) {
      // 條目 11.e & 11.b：優先檢查清運e點通官方動態班表與 estimate
      let officialStop = null;
      if (runId && liveRouteSchedules && liveRouteSchedules[runId] && liveRouteSchedules[runId].stops) {
        const stopsMap = liveRouteSchedules[runId].stops;
        if (stopName && stopsMap[stopName]) {
          officialStop = stopsMap[stopName];
        } else if (!isNaN(stopLat) && !isNaN(stopLon)) {
          officialStop = stopsMap[`${Number(stopLat).toFixed(4)},${Number(stopLon).toFixed(4)}`] || stopsMap[`${stopLat},${stopLon}`];
        }
      }

      // 條目 11.e：第 1 項的「已駛離」判斷，直接採用官方 estimate 的「已清運」，不再自己用車速推算
      if (officialStop && officialStop.estimate === "已清運") {
        return {
          hasLive: true,
          badgeColor: '#9A3412',
          badgeBg: '#FFEDD5',
          border: '#FDBA74',
          dotColor: '#EA580C',
          label: '⚠️ 車輛已駛離本站',
          detail: '清運e點通即時狀態：此站已清運完畢駛離！',
          delayMin: 0,
          isPassed: true
        };
      }

      // 條目 11.b：若官方有「已抵達」或「約X分到」
      if (officialStop && officialStop.estimate) {
        if (officialStop.estimate === "已抵達") {
          return {
            hasLive: true,
            badgeColor: '#065F46',
            badgeBg: '#D1FAE5',
            border: '#6EE7B7',
            dotColor: '#10B981',
            label: '🛑 垃圾車正在現場收運中！',
            detail: '清運e點通即時車機狀態：垃圾車已抵達現場！',
            delayMin: 0,
            isPassed: false
          };
        } else if (officialStop.estimate.includes("分到")) {
          return {
            hasLive: true,
            badgeColor: '#065F46',
            badgeBg: '#ECFDF5',
            border: '#A7F3D0',
            dotColor: '#10B981',
            label: `🟢 官方即時預估：${officialStop.estimate}`,
            detail: '清運e點通車機即時路況動態計算到站時間',
            delayMin: 0,
            isPassed: false
          };
        }
      }

      const normKey = normalizePlate(plate);
      const truck = (liveTrucksCache && (liveTrucksCache[normKey] || liveTrucksCache[plate])) || null;

      if (!truck || truck.status === "未執勤") {
        if (officialStop && officialStop.stime) {
          return {
            hasLive: false,
            badgeColor: '#2563EB',
            badgeBg: '#EFF6FF',
            border: '#BFDBFE',
            dotColor: '#3B82F6',
            label: '⚪ 依官方今日班表',
            detail: `今日表定 ${officialStop.stime}，車機目前離峰或尚未出勤`,
            delayMin: 0,
            isPassed: false
          };
        }
        return {
          hasLive: false,
          badgeColor: '#64748B',
          badgeBg: '#F1F5F9',
          border: '#E2E8F0',
          dotColor: '#94A3B8',
          label: '⚪ 依官方表定時間',
          detail: '車機目前離峰或尚未出勤',
          delayMin: 0,
          isPassed: false
        };
      }

      if (!truck.visitedStops) {
        truck.visitedStops = {};
      }

      const stopKey = makeStopKey(stopLat, stopLon);
      const dist = haversine(truck.lat, truck.lon, stopLat, stopLon);

      // 只要進入該站 120m 內，即寫入 visitedStops 歷史紀錄
      if (dist <= 120) {
        truck.visitedStops[stopKey] = true;
      }

      const hasVisited = Boolean(
        truck.visitedStops[stopKey] ||
        truck.visitedStops[`${stopLat},${stopLon}`]
      );

      // 市區垃圾車平均速度約 260 公尺/分鐘 (考量停等家戶投遞)
      const liveEtaMin = Math.max(1, Math.round(dist / 260));

      const now = (typeof window !== 'undefined' && window.__TEST_NOW__) ? new Date(window.__TEST_NOW__) : new Date();
      const currentMin = now.getHours() * 60 + now.getMinutes();
      const estArrivalMin = currentMin + liveEtaMin;
      const delayMin = estArrivalMin - stopMin;

      // 1. 車輛已過站判定：只有「曾到過該站 120m 內 (hasVisited) 且已離開 > 400m」才判已駛離！
      if (hasVisited && dist > 400) {
        return {
          hasLive: true,
          badgeColor: '#9A3412',
          badgeBg: '#FFEDD5',
          border: '#FDBA74',
          dotColor: '#EA580C',
          label: '⚠️ 車輛已駛離本站',
          detail: `車輛已通過該路段（目前距離 ${dist}m）`,
          delayMin: delayMin,
          isPassed: true,
          dist: dist,
          liveEtaMin: liveEtaMin
        };
      }

      // 若時間已過表定 > 2 分鐘且車距 > 400m，但「從未記錄到進入本站 120m 內 (!hasVisited)」
      // 無法確定是否已過站或晚到，一律顯示「依官方表定時間」
      if (currentMin > stopMin + 2 && dist > 400 && !hasVisited) {
        return {
          hasLive: false,
          badgeColor: '#64748B',
          badgeBg: '#F1F5F9',
          border: '#E2E8F0',
          dotColor: '#94A3B8',
          label: '⚪ 依官方表定時間',
          detail: '依官方班表時間為準',
          delayMin: delayMin,
          isPassed: false,
          dist: dist,
          liveEtaMin: liveEtaMin
        };
      }

      // 2. 現場收運中判定 (距離站點 120m 內且慢速/停等)
      if (dist <= 120 && (truck.speed === undefined || truck.speed <= 8)) {
        return {
          hasLive: true,
          badgeColor: '#065F46',
          badgeBg: '#D1FAE5',
          border: '#6EE7B7',
          dotColor: '#10B981',
          label: '🛑 垃圾車正在現場收運中！',
          detail: `垃圾車已在站點周邊（距此站 ${dist}m），請立即前往投遞！`,
          delayMin: delayMin,
          isPassed: false,
          dist: dist,
          liveEtaMin: 0
        };
      }

      // 3. 誤點情況判定 (比表定時間晚 4 分鐘以上)
      if (delayMin >= 4) {
        const estH = String(Math.floor(estArrivalMin / 60) % 24).padStart(2, '0');
        const estM = String(estArrivalMin % 60).padStart(2, '0');
        return {
          hasLive: true,
          badgeColor: '#9A3412',
          badgeBg: '#FFF7ED',
          border: '#FED7AA',
          dotColor: '#F97316',
          label: `🔴 預估稍有延誤 (${delayMin} 分鐘)`,
          detail: `沿途清運量較大，目前距離此站 ${dist}m，預計約 ${estH}:${estM} 抵達 (請從容出發，不必在路口吹風)`,
          delayMin: delayMin,
          isPassed: false,
          dist: dist,
          liveEtaMin: liveEtaMin
        };
      }

      // 4. 正常行駛接近中（條目 11：車在跑時，即時狀態不得是灰色的離峰）
      return {
        hasLive: true,
        badgeColor: '#065F46',
        badgeBg: '#ECFDF5',
        border: '#A7F3D0',
        dotColor: '#10B981',
        label: `🟢 即時動態：垃圾車行駛中`,
        detail: `距離此站約 ${dist}m，預估還有 ${liveEtaMin} 分鐘抵達`,
        delayMin: delayMin,
        isPassed: false,
        dist: dist,
        liveEtaMin: liveEtaMin
      };
    }

    // 第 7 項：當非同步取得即時車機後，僅微更新 DOM 中的即時徽章區塊 (零閃爍)
    function updateCardsWithLiveStatus() {
      const liveFastestEl = document.getElementById('liveFastestStatusBox');
      if (liveFastestEl && liveFastestEl.dataset.plate) {
        const p = liveFastestEl.dataset.plate;
        const lat = parseFloat(liveFastestEl.dataset.lat);
        const lon = parseFloat(liveFastestEl.dataset.lon);
        const sMin = parseInt(liveFastestEl.dataset.stopmin, 10);
        const runId = liveFastestEl.dataset.runid || "";
        const stopName = liveFastestEl.dataset.stopname || "";
        const status = evaluateLiveTruckStatus(p, lat, lon, sMin, runId, stopName);

        liveFastestEl.innerHTML = `
          <div style="display: flex; align-items: center; gap: 6px; font-weight: 800; font-size: 13px; color: ${status.badgeColor};">
            <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: ${status.dotColor}; animation: pulse 1.5s infinite;"></span>
            <span>${status.label}</span>
          </div>
          <div style="font-size: 12px; color: ${status.badgeColor}; opacity: 0.95; line-height: 1.4; margin-top: 2px;">
            ${status.detail}
          </div>
        `;
        liveFastestEl.style.backgroundColor = status.badgeBg;
        liveFastestEl.style.borderColor = status.border;
      }
    }

    // 第 4 項：計算定點收運站（只開週一、二、四、五 07:30-08:30）下一個開放日資訊
    function getNextFixedStationOpenInfo(currentDay) {
      const OPEN_DAYS = [1, 2, 4, 5];
      const DAY_NAMES = ["週日", "週一", "週二", "週三", "週四", "週五", "週六"];
      const tomorrow = (currentDay + 1) % 7;
      if (OPEN_DAYS.includes(tomorrow)) {
        return {
          isTomorrowOpen: true,
          nextDayName: DAY_NAMES[tomorrow],
          pillText: "明早 07:30 救急",
          cardTitlePrefix: "明日早晨救急首選・定點收運站",
          rightBoxLabel: "明日早晨開放",
          rightBoxValue: "07:30",
          navBtnText: (stationName) => `🧭 一鍵導航至明早定點站 (${stationName})`,
          noticeHtml: ""
        };
      }
      // 隔天不開（例如週二晚上、週五晚上、週六晚上），往後找下一個開放日
      let offset = 2;
      while (offset <= 7) {
        const candidateDay = (currentDay + offset) % 7;
        if (OPEN_DAYS.includes(candidateDay)) {
          const nextName = DAY_NAMES[candidateDay];
          return {
            isTomorrowOpen: false,
            nextDayName: nextName,
            pillText: `下一個開放日 ${nextName} 07:30`,
            cardTitlePrefix: `定點站隔日停開・下一個開放日 ${nextName} 07:30`,
            rightBoxLabel: "下一個開放日",
            rightBoxValue: `${nextName} 07:30`,
            navBtnText: (stationName) => `🧭 查看定點站位置 (${stationName}・${nextName} 07:30 開放)`,
            noticeHtml: `
              <div style="background: #FFF7ED; border: 1px solid #FED7AA; border-radius: 12px; padding: 10px 14px; margin-bottom: 10px; font-size: 13px; color: #9A3412; line-height: 1.5;">
                <strong>⚠️ 定點站開放日提醒：</strong> 定點收運站僅每週一、二、四、五 07:30-08:30 開放，<strong>下一個開放日為 ${nextName} 07:30</strong>。<br>
                不想把垃圾堆在家裡苦等？歡迎直接預約下方【生活管家 999 包月到府代倒】！
              </div>
            `
          };
        }
        offset++;
      }
    }

    // 預設台東座標 (鐵花/轉運站)
    let currentLat = 22.7518;
    let currentLon = 121.1475;
    let currentAreaName = "鐵花村 / 轉運站周邊";
    let currentLocMode = 'gps'; // 'gps' 或 'manual'
    let currentTravelMode = 'scooter'; // 創辦人指引：預設台東常民生活首選【🛵 騎機車】！

    // 交通工具動力模型：速度 (公尺/分)、圖示與 Google Maps 導航協議
    const TRAVEL_PROFILES = {
      walking: { name: "步行", speedMpm: 75, icon: "🚶", gmapMode: "walking", desc: "(步行約 4.5km/h)" },
      scooter: { name: "騎車", speedMpm: 500, icon: "🛵", gmapMode: "two-wheeler", desc: "(騎機車約 30km/h)" },
      car:     { name: "開車", speedMpm: 400, icon: "🚗", gmapMode: "driving", desc: "(開車市區含臨停約 24km/h)" }
    };

    function setTravelMode(mode) {
      currentTravelMode = mode;
      document.querySelectorAll('#modeWalkBtn, #modeScooterBtn, #modeCarBtn').forEach(b => b.classList.remove('active'));
      const desc = document.getElementById('travelModeDesc');
      if (mode === 'walking') {
        document.getElementById('modeWalkBtn').classList.add('active');
        desc.innerText = TRAVEL_PROFILES.walking.desc;
      } else if (mode === 'scooter') {
        document.getElementById('modeScooterBtn').classList.add('active');
        desc.innerText = TRAVEL_PROFILES.scooter.desc;
      } else if (mode === 'car') {
        document.getElementById('modeCarBtn').classList.add('active');
        desc.innerText = TRAVEL_PROFILES.car.desc;
      }
      renderRadar();
    }

    // 台東市區主要地標與路段地理詞庫 (包含新站特區、外環聚落與創辦人實測路段)
    const TAITUNG_GEO_DICT = [
      { keywords: ["興航", "興航街", "興安路一段", "興安", "新站特區"], name: "台東市新站特區/興航街", lat: 22.7932, lon: 121.1218 },
      { keywords: ["台東新站", "台東車站", "火車站", "志航路一段", "文昌路"], name: "台東新站/志航路前站", lat: 22.7930, lon: 121.1225 },
      { keywords: ["正氣", "基督教醫院", "夜市", "正氣路"], name: "台東市正氣路商圈", lat: 22.7535, lon: 121.1512 },
      { keywords: ["鐵花", "轉運站", "秀泰", "新生路", "鐵花村"], name: "台東市鐵花村/轉運站", lat: 22.7518, lon: 121.1475 },
      { keywords: ["寶桑", "精誠", "寶桑路"], name: "台東市寶桑路老街", lat: 22.7588, lon: 121.1522 },
      { keywords: ["四維", "強國", "四維路"], name: "台東市四維路一段", lat: 22.7610, lon: 121.1505 },
      { keywords: ["更生", "馬偕", "馬偕醫院", "更生路"], name: "台東市更生路/馬偕醫院", lat: 22.7560, lon: 121.1440 },
      { keywords: ["傳廣", "傳廣路"], name: "台東市傳廣路段", lat: 22.7582, lon: 121.1395 },
      { keywords: ["東海", "漢陽", "中華路二段", "東海運動公園"], name: "台東市中華路二段/東海", lat: 22.7420, lon: 121.1390 },
      { keywords: ["豐榮", "漢中", "豐榮路"], name: "台東市豐榮路/漢中街", lat: 22.7405, lon: 121.1352 },
      { keywords: ["豐年", "康樂", "中興路二段", "中興路三段", "機場"], name: "台東市豐年/康樂機場特區", lat: 22.7630, lon: 121.1180 },
      { keywords: ["大豐", "豐里", "中華路三段", "中華路四段"], name: "台東市大豐/豐里生活圈", lat: 22.7230, lon: 121.1380 },
      { keywords: ["知本", "建興", "青海路", "大學路", "知本車站"], name: "台東市知本/建興生活圈", lat: 22.7050, lon: 121.0580 },
      { keywords: ["富岡", "石川", "松江路", "漁港"], name: "台東市富岡漁港/海線圈", lat: 22.7920, lon: 121.1920 },
      { keywords: ["南王", "卑南", "更生北路", "綠色隧道"], name: "台東市南王/卑南文化區", lat: 22.7820, lon: 121.1180 }
    ];

    function switchLocMode(mode) {
      currentLocMode = mode;
      const tabGps = document.getElementById('tabGpsBtn');
      const tabManual = document.getElementById('tabManualBtn');
      const gpsView = document.getElementById('gpsView');
      const manualView = document.getElementById('manualView');

      if (mode === 'gps') {
        tabGps.classList.add('active');
        tabManual.classList.remove('active');
        gpsView.style.display = 'flex';
        manualView.style.display = 'none';
        requestLocation();
      } else {
        tabManual.classList.add('active');
        tabGps.classList.remove('active');
        gpsView.style.display = 'none';
        manualView.style.display = 'flex';
        const inp = document.getElementById('manualAddressInput');
        inp.focus();
      }
    }

    async function searchManualAddress() {
      const q = document.getElementById('manualAddressInput').value.trim();
      const notice = document.getElementById('manualSearchNotice');
      if (!q) {
        notice.innerText = "⚠️ 請輸入路名或門牌地址！";
        notice.style.color = "#DC2626";
        return;
      }

      notice.innerText = "🔍 正在精準定位中...";
      notice.style.color = "#0284C7";

      let match = TAITUNG_GEO_DICT.find(item => 
        item.keywords.some(kw => q.includes(kw) || kw.includes(q))
      );

      if (match) {
        currentLat = match.lat;
        currentLon = match.lon;
        currentAreaName = match.name;
        notice.innerText = `✅ 已精準定位至【${match.name}】！`;
        notice.style.color = "#059669";
        renderRadar();
        return;
      }

      try {
        const query = q.includes("台東") ? q : `台東縣台東市 ${q}`;
        const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=1&countrycodes=tw`;
        const res = await fetch(url, { headers: { 'Accept-Language': 'zh-TW' } });
        const data = await res.json();
        if (data && data.length > 0) {
          currentLat = parseFloat(data[0].lat);
          currentLon = parseFloat(data[0].lon);
          currentAreaName = q;
          notice.innerText = `✅ 已成功定位至【${q}】！(${currentLat.toFixed(4)}, ${currentLon.toFixed(4)})`;
          notice.style.color = "#059669";
          renderRadar();
          return;
        }
      } catch (e) {
        console.warn("Geocoding fetch error:", e);
      }

      notice.innerText = `⚠️ 找不到「${q}」的確切位置！請確認路名（如：興航街、正氣路），或改點上方【🎯 手機自動定位】`;
      notice.style.color = "#DC2626";
    }

    function initTimeInput() {
      const now = (typeof window !== 'undefined' && window.__TEST_NOW__) ? new Date(window.__TEST_NOW__) : new Date();
      const currentH = now.getHours();
      const currentM = now.getMinutes();
      const timeInput = document.getElementById('trashTimeInput');
      const timeDesc = document.getElementById('timeRelativeDesc');

      if (currentH < 15 || currentH >= 21) {
        timeInput.value = "17:15";
        timeDesc.innerText = "(推薦 17:15 清運時段)";
      } else {
        const hh = String(currentH).padStart(2, '0');
        const mm = String(currentM).padStart(2, '0');
        timeInput.value = `${hh}:${mm}`;
        timeDesc.innerText = "(目前手機時間)";
      }
    }

    function onTimeInputChange() {
      const val = document.getElementById('trashTimeInput').value;
      if (val) {
        document.getElementById('timeRelativeDesc').innerText = `(預計 ${val} 出發)`;
        prefetchTodaySchedules();
        renderRadar();
      }
    }

    function setNowTime() {
      const now = (typeof window !== 'undefined' && window.__TEST_NOW__) ? new Date(window.__TEST_NOW__) : new Date();
      const hh = String(now.getHours()).padStart(2, '0');
      const mm = String(now.getMinutes()).padStart(2, '0');
      document.getElementById('trashTimeInput').value = `${hh}:${mm}`;
      document.getElementById('timeRelativeDesc').innerText = `(現在 ${hh}:${mm})`;
      prefetchTodaySchedules();
      renderRadar();
    }

    function quickSetTime(tStr) {
      document.getElementById('trashTimeInput').value = tStr;
      document.getElementById('timeRelativeDesc').innerText = `(指定 ${tStr} 出發)`;
      prefetchTodaySchedules();
      renderRadar();
    }

    function toggleRecycle(e) {
      if (e.target.id !== 'recycleCheckbox') {
        const cb = document.getElementById('recycleCheckbox');
        cb.checked = !cb.checked;
        onRecycleChange();
      }
    }

    function onRecycleChange() {
      const cb = document.getElementById('recycleCheckbox');
      const box = document.getElementById('recycleBox');
      const sub = document.getElementById('recycleSubText');
      const title = document.getElementById('recycleTitleText');
      if (cb.checked) {
        box.style.borderColor = '#059669';
        box.style.backgroundColor = '#ECFDF5';
        title.style.color = '#065F46';
        sub.innerText = '✅ 已勾選：僅為您篩選【一般垃圾 ＋ 資源回收車】雙收班次！';
      } else {
        box.style.borderColor = '#E2E8F0';
        box.style.backgroundColor = '#F8FAFC';
        title.style.color = 'var(--text-main)';
        sub.innerText = '未勾選默認只倒垃圾；勾選後只顯示【垃圾+回收雙收】車次';
      }
      prefetchTodaySchedules();
      renderRadar();
    }

    // 本地內建台東站點快取 (含第 10 項站點層 recycle_day 欄位)
    let LOCAL_SEED_ROUTES = []; // 資料改由 data/garbage_routes.json 載入（見 loadRouteData）
    let RECYCLING_SEED_ROUTES = []; // 資料改由 data/recycling_routes.json 載入（見 loadRouteData）
    // RECYCLING_SEED_ROUTES kept separate for dedicated recycle matching


    // 台東常態三大早晨定點收運站
    let FIXED_STATIONS = []; // 資料改由 data/fixed_stations.json 載入（見 loadRouteData）

    function updateLiveClock() {
      const now = (typeof window !== 'undefined' && window.__TEST_NOW__) ? new Date(window.__TEST_NOW__) : new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const el = document.getElementById('liveClock');
      if (el) el.innerText = `${h}:${m}`;
    }
    setInterval(updateLiveClock, 1000);
    updateLiveClock();

    function haversine(lat1, lon1, lat2, lon2) {
      const R = 6371000;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a = Math.sin(dLat / 2) ** 2 +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon / 2) ** 2;
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      return Math.round(R * c * 1.25); // 路網折算係數
    }

    function requestLocation() {
      const btn = document.getElementById('gpsTriggerBtn');
      const locText = document.getElementById('currentLocationText');
      btn.innerHTML = "<span>⏳ 定位中...</span>";
      
      if (!navigator.geolocation) {
        alert("您的瀏覽器未開啟定位授權，為您使用預設生活圈。");
        btn.innerHTML = "<span>🎯 GPS 定位</span>";
        return;
      }

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          currentLat = pos.coords.latitude;
          currentLon = pos.coords.longitude;
          btn.innerHTML = "<span>✅ 定位成功</span>";
          locText.innerText = `GPS 定位 (${currentLat.toFixed(4)}, ${currentLon.toFixed(4)})`;
          document.querySelectorAll('.area-chip').forEach(c => c.classList.remove('active'));
          renderRadar();
        },
        (err) => {
          console.warn("GPS error:", err);
          btn.innerHTML = "<span>⚠️ 請手選生活圈</span>";
          renderRadar();
        },
        { timeout: 5000, enableHighAccuracy: true }
      );
    }

    function formatMinToTimeStr(m) {
      const hh = String(Math.floor(m / 60)).padStart(2, '0');
      const mm = String(m % 60).padStart(2, '0');
      return `${hh}:${mm}`;
    }

    
    // B 項：挑站前先抓全部今日出勤路線班表 (全量並行預載)
    async function prefetchTodaySchedules() {
      const timeInputEl = document.getElementById('trashTimeInput');
      const targetTimeVal = timeInputEl ? timeInputEl.value : '17:00';
      const [th, tm] = (targetTimeVal || '17:00').split(':').map(Number);
      const targetMin = th * 60 + tm;
      const now = (typeof window !== 'undefined' && window.__TEST_NOW__) ? new Date(window.__TEST_NOW__) : new Date();
      const currentMin = now.getHours() * 60 + now.getMinutes();
      const day = now.getDay();
      if (day === 0 || day === 3) return; // 停收日不抓

      const DAY_CHARS = ["日", "一", "二", "三", "四", "五", "六"];
      const currentDayChar = DAY_CHARS[day];
      const recycleEl = document.getElementById('recycleCheckbox');
      const wantRecycle = recycleEl ? recycleEl.checked : false;

      // 挑出今日有出勤的路線 runId (雙收專用回收車路線，單倒垃圾專用垃圾車路線)
      const todayRunIds = [];
      const activeRoutes = wantRecycle ? (RECYCLING_SEED_ROUTES || []) : (LOCAL_SEED_ROUTES || []);
      activeRoutes.forEach(r => {
        const routeDays = r.is_recycling_truck ? (r.recycle_day || r.trash_day) : r.trash_day;
        if (routeDays && routeDays.includes(currentDayChar)) {
          const rid = (r.run_id || (r.route_id || '').replace(/^TT_OFFICIAL_/, '').replace(/^TT_RECYCLE_/, ''));
          if (rid && !todayRunIds.includes(rid)) todayRunIds.push(rid);
        }
      });

      const missingRunIds = todayRunIds.filter(rid => !isFetchingSchedule[rid] && (!liveRouteSchedules[rid] || (Date.now() - liveRouteSchedules[rid].timestamp >= SCHEDULE_CACHE_TTL)));
      if (missingRunIds.length === 0) return;

      try {
        await Promise.allSettled(missingRunIds.map(rid => fetchRouteSchedule(rid)));
        renderRadar(); // 抓完自動以最新官方班表重新精準演算挑站
      } catch (err) {
        console.warn("prefetchTodaySchedules error:", err);
      }
    }

    function renderRadar() {
      fetchLiveTruckLocations(); // 靜音非同步查詢即時車機
      const now = (typeof window !== 'undefined' && window.__TEST_NOW__) ? new Date(window.__TEST_NOW__) : new Date();
      const day = now.getDay(); // 0 is Sunday, 3 is Wednesday
      const isOffDay = (day === 0 || day === 3); // 台東在地：週日與週三例休！

      const alertContainer = document.getElementById('alertContainer');
      const cardsContainer = document.getElementById('cardsContainer');
      cardsContainer.innerHTML = '';
      alertContainer.innerHTML = '';

      const timeInput = document.getElementById('trashTimeInput');
      const targetTimeStr = (timeInput && timeInput.value) ? timeInput.value : "17:15";
      const [th, tm] = targetTimeStr.split(':').map(Number);
      const targetMinutes = th * 60 + tm;
      const wantRecycle = document.getElementById('recycleCheckbox') ? document.getElementById('recycleCheckbox').checked : false;
      const profile = TRAVEL_PROFILES[currentTravelMode] || TRAVEL_PROFILES.scooter;

      // 定點收運站 (早晨救急) 與隔天開放日判斷 (第 4 項)
      const fixedStationsWithDist = FIXED_STATIONS.map(f => ({
        ...f,
        dist: haversine(currentLat, currentLon, f.lat, f.lon),
        travelMin: Math.max(1, Math.round(haversine(currentLat, currentLon, f.lat, f.lon) / profile.speedMpm))
      })).sort((a, b) => a.dist - b.dist);
      const topFixed = fixedStationsWithDist[0] || { name: '南京路與正氣路口廣場', lat: 22.75382, lon: 121.14925, dist: 500, travelMin: 3 };
      const fixedOpenInfo = getNextFixedStationOpenInfo(day);

      // 第 2 項：停收日 (週三、週日) 跳過站點計算，只顯示停收橫幅、定點站卡、代倒入口
      if (isOffDay) {
        alertContainer.innerHTML = `
          <div class="alert-banner alert-danger">
            <span style="font-size: 20px;">🚫</span>
            <div>
              <strong>今日台東市清潔隊例行停收！</strong><br>
              台東固定每週三與週日全縣停收垃圾。今日無夜間清運車次，請勿將垃圾堆置門外以免受罰！
            </div>
          </div>
        `;

        if (topFixed) {
          cardsContainer.innerHTML += `
            <div class="card">
              <div class="card-tag tag-fixed">🥉 停收日救急・${fixedOpenInfo.pillText}</div>
              <div class="card-title-row">
                <div class="stop-name">${topFixed.name}</div>
              </div>
              ${fixedOpenInfo.noticeHtml}
              <div class="card-meta-grid">
                <div class="meta-item">
                  <span class="meta-label">${fixedOpenInfo.rightBoxLabel}</span>
                  <span class="meta-val" style="color: #D97706;">${fixedOpenInfo.isTomorrowOpen ? '明早 07:30 - 08:30' : fixedOpenInfo.rightBoxValue + ' - 08:30'}</span>
                </div>
                <div class="meta-item">
                  <span class="meta-label">距離目前位置</span>
                  <span class="meta-val">${topFixed.dist} 公尺 (${profile.name}約 ${topFixed.travelMin} 分鐘)</span>
                </div>
              </div>
              <a class="nav-btn secondary" href="https://www.google.com/maps/dir/?api=1&destination=${topFixed.lat},${topFixed.lon}&travelmode=${profile.gmapMode}" target="_blank">
                ${fixedOpenInfo.navBtnText(topFixed.name)}
              </a>
              <a class="nav-btn" style="background: #FFF7ED; color: #9A3412; border: 1.5px solid #FDBA74;" href="#upsellCard">
                🛋️ 停收日不想囤垃圾？預約生活管家 999 包月到府代倒
              </a>
            </div>
          `;
        }
        return;
      }

      // 2. 非停收日空間演算計算：落實創辦人親傳實戰演算法
      let allStops = [];
      let todayAllRouteMinStop = Infinity;
      let todayAllRouteMaxStop = -Infinity;
      const DAY_CHARS = ["日", "一", "二", "三", "四", "五", "六"];
      const currentDayChar = DAY_CHARS[day];

      // 雙收模式依創辦人指令改為專用回收車路線 (RECYCLING_SEED_ROUTES)，單倒垃圾為 (LOCAL_SEED_ROUTES)
      const activeRoutes = wantRecycle ? (RECYCLING_SEED_ROUTES || []) : (LOCAL_SEED_ROUTES || []);

      // 遍歷路線與官方班表 (過站判斷只採用官方 estimate「已清運」，沒有官方狀態時一律不隱藏站點)
      activeRoutes.forEach(route => {
        const routeDays = route.is_recycling_truck ? (route.recycle_day || route.trash_day) : route.trash_day;
        if (routeDays && !routeDays.includes(currentDayChar)) return;

        const runId = (route.run_id || (route.route_id || '').replace(/^TT_OFFICIAL_/, '').replace(/^TT_RECYCLE_/, ''));
        const officialSchedule = (liveRouteSchedules && liveRouteSchedules[runId]) ? liveRouteSchedules[runId] : null;
        const liveTruck = getLiveTruckForRoute(route);

        route.stops.forEach((stop, stopIdx) => {
          let stopTime = stop.time;
          let isOffline = true;
          let officialEst = "";

          if (officialSchedule && officialSchedule.stops) {
            const offInfo = officialSchedule.stops[stop.name] || officialSchedule.stops[`${Number(stop.lat).toFixed(4)},${Number(stop.lon).toFixed(4)}`] || officialSchedule.stops[`${stop.lat},${stop.lon}`];
            if (offInfo && offInfo.stime) {
              stopTime = offInfo.stime;
              isOffline = false;
              officialEst = offInfo.estimate || "";
            }
          }

          const [sh, sm] = stopTime.split(':').map(Number);
          const stopMin = sh * 60 + sm;
          if (stopMin < todayAllRouteMinStop) todayAllRouteMinStop = stopMin;
          if (stopMin > todayAllRouteMaxStop) todayAllRouteMaxStop = stopMin;

          // 資源回收日嚴格判定
          let stopRecycleDay = stop.recycle_day || route.recycle_day || '無';
          const matchRecycleTag = stop.name.match(/\(週([一二三四五六日、. ]+)回收車\)/);
          if (matchRecycleTag) {
            stopRecycleDay = matchRecycleTag[1];
          }
          const stopHasRecyclingToday = (stopRecycleDay !== '無' && stopRecycleDay.includes(currentDayChar));
          if (wantRecycle && !stopHasRecyclingToday) {
            return;
          }

          const dist = haversine(currentLat, currentLon, stop.lat, stop.lon);
          const travelMin = Math.max(1, Math.round(dist / profile.speedMpm));
          const userArrivalMin = targetMinutes + travelMin;

          // =========================================================================
          // 【過站判定最高原則】：只採用官方 estimate「已清運」；沒有官方狀態時，一律不隱藏站點
          // =========================================================================
          let isPassed = false;
          if (officialEst && (officialEst.includes("已清運") || officialEst.includes("已駛離") || officialEst.includes("已離開"))) {
            isPassed = true;
          }

          // 沒有官方狀態時（離線或無 estimate），若表定時間在 15 分鐘以內，加註提早出門警告 (照常推薦，不排除)
          let isEarlyWarning = false;
          if (isOffline || !officialEst) {
            if (stopMin >= targetMinutes && stopMin <= targetMinutes + 15) {
              isEarlyWarning = true;
            }
          }

          // 每一站計算：車預估幾點到 (truckEtaMin)
          let truckEtaMin = stopMin;
          if (officialEst && officialEst.includes("分到")) {
            const m = officialEst.match(/約(\d+)分到/);
            if (m) {
              truckEtaMin = targetMinutes + parseInt(m[1], 10);
            }
          } else if (officialEst === "已抵達") {
            truckEtaMin = targetMinutes;
          }

          // 只保留「客人能比車先到」的站
          const canCatch = (!isPassed && userArrivalMin <= truckEtaMin);
          const totalTaskMinutes = Math.max(travelMin, truckEtaMin - targetMinutes);
          const waitAtStopMin = Math.max(0, truckEtaMin - userArrivalMin);

          allStops.push({
            routeId: route.route_id,
            runId: runId,
            routeName: route.route_name,
            plate: (liveTruck && liveTruck.car_no) ? liveTruck.car_no : route.truck_plate,
            hasRecycling: stopHasRecyclingToday,
            recycleDay: stopRecycleDay,
            name: stop.name,
            stopIdx: stopIdx,
            lat: stop.lat,
            lon: stop.lon,
            time: stopTime,
            rawSeedTime: stop.time,
            isOffline: isOffline,
            officialEst: officialEst,
            isPassed: isPassed,
            isEarlyWarning: isEarlyWarning,
            stopMin: stopMin,
            truckEtaMin: truckEtaMin,
            dist: dist,
            travelMin: travelMin,
            userArrivalMin: userArrivalMin,
            canCatch: canCatch,
            totalTaskMinutes: totalTaskMinutes,
            waitAtStopMin: waitAtStopMin,
            liveTruck: liveTruck,
            notes: stop.notes
          });
        });
      });

      // 今日最晚與最早站點時間
      const minStopMin = allStops.length > 0 ? Math.min(...allStops.map(s => s.stopMin)) : (todayAllRouteMinStop !== Infinity ? todayAllRouteMinStop : 930);
      const maxStopMin = allStops.length > 0 ? Math.max(...allStops.map(s => s.stopMin)) : (todayAllRouteMaxStop !== -Infinity ? todayAllRouteMaxStop : 1280);
      const earliestTimeStr = formatMinToTimeStr(minStopMin);
      const latestTimeStr = formatMinToTimeStr(maxStopMin);

      // 全日離家最近站點 (僅用於判定家門口原班次是否已過)
      const allStopsByDist = [...allStops].sort((a, b) => a.dist - b.dist || a.stopMin - b.stopMin);
      const nearestAnyTime = allStopsByDist[0] || null;

      // =========================================================================
      // 【2｜卡片 2 離家最近】：嚴格排除已過站 (!s.isPassed)，只從「未過站且表定時間 ≥ 出門時間」挑最近的
      // =========================================================================
      const upcomingStopsByDist = allStops
        .filter(s => !s.isPassed && s.stopMin >= targetMinutes)
        .sort((a, b) => a.dist - b.dist || a.stopMin - b.stopMin);
      const topNearest = upcomingStopsByDist[0] || null;
      if (topNearest) {
        topNearest.walkingMin = Math.max(1, Math.round(topNearest.dist / TRAVEL_PROFILES.walking.speedMpm));
      }

      // 判定家門口最近班次是否已經開走
      const isLocalShiftMissed = Boolean(nearestAnyTime && (nearestAnyTime.isPassed || nearestAnyTime.stopMin < targetMinutes));

      let topFastest = null;
      let shiftState = 'LIVE'; // LIVE | INTERCEPT | NIGHT_CLOSED | DAY_PREVIEW

      // =========================================================================
      // 【1｜「最快」卡片：從車出發找站】
      // 1. 抓出現在所有正在出勤的車的實際 GPS 位置（垃圾車與回收車都要）。
      // 2. 每一台車只看它還沒經過的站 (!s.isPassed)。
      // 3. 每一站計算：車預估幾點到、客人從定位點出發幾點到。
      // 4. 只保留「客人能比車先到」的站 (s.canCatch: userArrivalMin <= truckEtaMin)。
      // 5. 從中選出客人最早完成倒垃圾 (truckEtaMin 最早，以「最早攔得到」為準)！
      // =========================================================================
      const liveTruckCandidates = [];
      const seenTruckRuns = new Set();
      if (liveTrucksCache) {
        Object.values(liveTrucksCache).forEach(t => {
          if (t && !isNaN(t.lat) && !isNaN(t.lon) && t.status !== "未執勤" && (t.speed > 0 || t.status === "執勤中")) {
            const runKey = t.run_id || t.car_no || t.name;
            if (!seenTruckRuns.has(runKey)) {
              seenTruckRuns.add(runKey);
              liveTruckCandidates.push(t);
            }
          }
        });
      }

      let bestFromTrucks = [];
      if (liveTruckCandidates.length > 0) {
        // 從所有出勤車輛的所有未過站點中，找出「客人能比車先到」的站
        allStops.forEach(s => {
          if (s.liveTruck && !s.isPassed && s.canCatch && s.totalTaskMinutes >= 0 && s.totalTaskMinutes <= 60) {
            bestFromTrucks.push(s);
          }
        });

        if (bestFromTrucks.length > 0) {
          // 以「最早攔得到（truckEtaMin 最小）」為準！若到站時間相同，選客人路程最近者
          bestFromTrucks.sort((a, b) => a.truckEtaMin - b.truckEtaMin || a.dist - b.dist);
          topFastest = bestFromTrucks[0];
          shiftState = isLocalShiftMissed ? 'INTERCEPT' : 'LIVE';
        }
      }

      // 若在線車輛均無可攔到站點，或處於離峰未發車時段，回退至未過站候選池中挑選
      if (!topFastest) {
        // 依創辦人指示：照常推薦，不排除 15 分鐘內的站點，家門口班次正常保留
        const unpassedCatchable = allStops.filter(s => 
          !s.isPassed && 
          s.canCatch && 
          s.totalTaskMinutes >= 0 && 
          s.totalTaskMinutes <= 60
        );

        if (unpassedCatchable.length > 0) {
          unpassedCatchable.sort((a, b) => (Math.floor(a.totalTaskMinutes / 3) - Math.floor(b.totalTaskMinutes / 3)) || (a.dist - b.dist));
          topFastest = unpassedCatchable[0];
          shiftState = isLocalShiftMissed ? 'INTERCEPT' : 'LIVE';
        } else {
          // 判定是否收工或白天離峰預報
          const allNightShiftsPast = allStops.length === 0 || allStops.every(s => s.isPassed || s.stopMin < targetMinutes);
          if (targetMinutes > maxStopMin || allNightShiftsPast) {
            shiftState = 'NIGHT_CLOSED';
          } else {
            // 白天或距離下一班超過 60 分鐘時段，顯示最近即將發車預報 (照常推薦，不排除)
            const earliestUpcoming = allStops
              .filter(s => !s.isPassed && s.stopMin >= targetMinutes)
              .sort((a, b) => a.stopMin - b.stopMin || a.dist - b.dist);
            topFastest = earliestUpcoming[0] || null;
            shiftState = topFastest ? 'DAY_PREVIEW' : 'NIGHT_CLOSED';
          }
        }
      }

      // 4. 渲染 卡片 1：最快抵達 / 時空救急安全梯
      if (shiftState === 'NIGHT_CLOSED') {
        cardsContainer.innerHTML += `
          <div class="card card-fastest" style="border-color: #6366F1; background: linear-gradient(180deg, #EEF2FF 0%, #FFFFFF 100%);">
            <div class="card-fastest-banner" style="background: linear-gradient(135deg, #4F46E5 0%, #3730A3 100%);">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 16px;">🌙</span>
                <span class="card-tag tag-fastest" style="background: transparent; padding: 0; box-shadow: none; font-size: 13px; font-weight: 900;">今晚台東夜間垃圾車已全數收工</span>
              </div>
              <div class="countdown-pill" style="background: rgba(0,0,0,0.22); border: 1px solid rgba(255,255,255,0.35); font-size: 12px;">${fixedOpenInfo.pillText}</div>
            </div>

            <div class="card-fastest-content">
              <div style="background: #E0E7FF; border: 1px solid #C7D2FE; border-radius: 12px; padding: 12px; margin-bottom: 12px; font-size: 13px; color: #3730A3; line-height: 1.5;">
                <strong>🚨 今晚夜間清運已全線結束！</strong><br>
                台東市今日垃圾車約於 ${earliestTimeStr} ~ ${latestTimeStr} 出勤。您預計出門時間（${targetTimeStr}）已無夜間車次。<br>
                <strong>別擔心！您有以下救急解法：</strong>
              </div>

              ${fixedOpenInfo.noticeHtml}

              <div class="card-title-row">
                <div>
                  <div style="font-size: 11px; color: #4338CA; font-weight: 800;">${fixedOpenInfo.cardTitlePrefix}</div>
                  <div class="stop-name" style="font-size: 20px;">${topFixed.name}</div>
                </div>
                <div style="text-align: right; background: #EEF2FF; padding: 6px 12px; border-radius: 12px; border: 1px solid #C7D2FE;">
                  <div style="font-size: 11px; color: #4338CA; font-weight: 700;">${fixedOpenInfo.rightBoxLabel}</div>
                  <div style="font-size: 18px; font-weight: 900; color: #3730A3;">${fixedOpenInfo.rightBoxValue}</div>
                </div>
              </div>

              <div class="card-meta-grid">
                <div class="meta-item">
                  <span class="meta-label">開放時段</span>
                  <span class="meta-val" style="color: #4338CA;">每週一二四五 07:30-08:30</span>
                </div>
                <div class="meta-item">
                  <span class="meta-label">離家距離</span>
                  <span class="meta-val">${topFixed.dist} 公尺 (${profile.name}約 ${topFixed.travelMin} 分鐘)</span>
                </div>
              </div>

              <a class="nav-btn" style="background: linear-gradient(135deg, #4F46E5 0%, #3730A3 100%); color: #FFF; margin-bottom: 8px;" href="https://www.google.com/maps/dir/?api=1&destination=${topFixed.lat},${topFixed.lon}&travelmode=${profile.gmapMode}" target="_blank">
                ${fixedOpenInfo.navBtnText(topFixed.name)}
              </a>

              <a class="nav-btn" style="background: #F8FAFC; color: #0F172A; border: 1.5px solid #CBD5E1;" href="#upsellCard">
                🛋️ 不想追車或囤垃圾？預約生活管家 999 包月到府代倒
              </a>
            </div>
          </div>
        `;
      } else if (topFastest && (shiftState === 'LIVE' || shiftState === 'INTERCEPT')) {
        const isIntercept = (shiftState === 'INTERCEPT');
        const titleTag = isIntercept 
          ? `🚨 家門口班次已過・火速跨區攔截！` 
          : (wantRecycle ? `🥇 ${targetTimeStr} 出發・【雙收】最快搞定` : `🥇 ${targetTimeStr} 出發・最快完成倒垃圾`);
        
        const arrH = Math.floor(topFastest.userArrivalMin / 60);
        const arrM = topFastest.userArrivalMin % 60;
        const userArrivalStr = `${String(arrH).padStart(2, '0')}:${String(arrM).padStart(2, '0')}`;

        // 第 9 項 & 第 11 項：evaluateLiveTruckStatus 只算一次存成變數 fastestLive (傳入 runId 與 stopName 啟用官方即時班表)
        const fastestLive = evaluateLiveTruckStatus(topFastest.plate, topFastest.lat, topFastest.lon, topFastest.stopMin, topFastest.runId, topFastest.name);

        cardsContainer.innerHTML += `
          <div class="card card-fastest" ${isIntercept ? 'style="border-color: #EA580C;"' : ''}>
            <div class="card-fastest-banner" ${isIntercept ? 'style="background: linear-gradient(135deg, #C2410C 0%, #9A3412 100%);"' : ''}>
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 16px; animation: pulse 1s infinite;">${isIntercept ? '⚡' : '🔥'}</span>
                <span class="card-tag tag-fastest" style="background: transparent; padding: 0; box-shadow: none; font-size: 13px; font-weight: 900;">${titleTag}</span>
              </div>
              <div class="countdown-pill" style="background: rgba(0,0,0,0.22); border: 1px solid rgba(255,255,255,0.35); box-shadow: none; font-size: 12px;">⚡ 出門 ${topFastest.totalTaskMinutes} 分鐘搞定！</div>
            </div>

            <div class="card-fastest-content">
              ${isIntercept ? `
                <div style="background: #FFF7ED; border: 1px solid #FFEDD5; border-radius: 12px; padding: 10px 14px; margin-bottom: 12px; font-size: 13px; color: #9A3412; line-height: 1.5;">
                  <strong>⚠️ 救急通報：</strong> 您住家附近較早班次（表定 ${nearestAnyTime ? nearestAnyTime.time : '先前'}）已過！<br>
                  生活管家雷達已自動為您鎖定<strong>鄰近生活圈趕得上</strong>的火速攔截點！<br>
                  ${currentTravelMode === 'walking' && topFastest.dist > 500 ? '🛵 <strong>強烈建議切換上方【騎機車】</strong>，出門只需數分鐘即可趕上！' : '請準時出發以防再次錯過！'}
                </div>
              ` : ''}

              <div class="card-title-row">
                <div>
                  <div style="font-size: 11px; color: #DC2626; font-weight: 800; letter-spacing: 0.5px;">${isIntercept ? '🔥 火速攔截點' : '首選攔截點'}</div>
                  <div class="stop-name" style="font-size: 21px;">${topFastest.name}</div>
                </div>
                <!-- F 項：同時清晰展示「官方表定時間」與「預估實際抵達時間」 -->
                <div style="display: flex; gap: 6px; align-items: stretch;">
                  <div style="text-align: right; background: #FFF5F5; padding: 6px 10px; border-radius: 12px; border: 1px solid #FECACA; min-width: 76px;">
                    <div style="font-size: 10px; color: #991B1B; font-weight: 700;">車次表定</div>
                    <div style="font-size: 18px; font-weight: 900; color: #DC2626; line-height: 1.1;">${topFastest.time}</div>
                    ${topFastest.isOffline ? '<div style="font-size: 9px; color: #D97706; font-weight: 700; margin-top: 2px;">⚠️ 離線表定，可能不準</div>' : '<div style="font-size: 9px; color: #059669; font-weight: 700; margin-top: 2px;">🟢 官方最新班表</div>'}
                  </div>
                  <div style="text-align: right; background: #F0FDF4; padding: 6px 10px; border-radius: 12px; border: 1px solid #BBF7D0; min-width: 82px;">
                    <div style="font-size: 10px; color: #166534; font-weight: 700;">預估抵達</div>
                    <div style="font-size: 15px; font-weight: 900; color: #15803D; line-height: 1.2; margin-top: 2px;">${fastestLive.statusText || fastestLive.label}</div>
                  </div>
                </div>
              </div>

              
              ${topFastest.isEarlyWarning ? `
                <div style="background: #FEF3C7; border: 1px solid #FCD34D; border-radius: 10px; padding: 6px 12px; margin-bottom: 10px; font-size: 12px; color: #92400E; font-weight: 700; display: flex; align-items: center; gap: 6px;">
                  <span>⚠️</span>
                  <span>車可能提早到，建議提早 15 分鐘出門</span>
                </div>
              ` : ''}

              ${topFastest.liveTruck ? `
                <div style="background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 10px; padding: 6px 12px; margin-bottom: 10px; font-size: 12px; color: #1E40AF; font-weight: 700; display: flex; align-items: center; gap: 6px;">
                  <span>🛰️</span>
                  <span>雷達已鎖定執勤車號：<strong>${topFastest.plate}</strong>（即時車距約 <strong>${haversine(currentLat, currentLon, topFastest.liveTruck.lat, topFastest.liveTruck.lon)}m</strong>，時速 ${Math.round(topFastest.liveTruck.speed || 0)} km/h）</span>
                </div>
              ` : ''}

              <!-- 🛰️ 即時車機動態微狀態 (第 9 項 & 第 11 項：單次計算變數渲染，含官方即時班表) -->
              <div id="liveFastestStatusBox" data-plate="${topFastest.plate}" data-lat="${topFastest.lat}" data-lon="${topFastest.lon}" data-stopmin="${topFastest.stopMin}" data-runid="${topFastest.runId || ''}" data-stopname="${topFastest.name}" style="background: ${fastestLive.badgeBg}; border: 1px solid ${fastestLive.border}; border-radius: 12px; padding: 8px 12px; transition: all 0.3s ease;">
                <div style="display: flex; align-items: center; gap: 6px; font-weight: 800; font-size: 13px; color: ${fastestLive.badgeColor};">
                  <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: ${fastestLive.dotColor}; animation: pulse 1.5s infinite;"></span>
                  <span>${fastestLive.label}</span>
                </div>
                <div style="font-size: 12px; color: ${fastestLive.badgeColor}; opacity: 0.95; line-height: 1.4; margin-top: 2px;">
                  ${fastestLive.detail}
                </div>
              </div>

              <!-- 任務完成時間節奏條 -->
              <div class="stepper-container">
                <div class="stepper-node">
                  <span class="stepper-time">${targetTimeStr}</span>
                  <span class="stepper-label">您出門出發</span>
                </div>
                <div class="stepper-arrow">
                  <span style="background: #FEE2E2; padding: 1px 6px; border-radius: 6px;">${profile.icon} ${topFastest.travelMin}分</span>
                  <span style="font-size: 13px;">➔</span>
                </div>
                <div class="stepper-node">
                  <span class="stepper-time">${userArrivalStr}</span>
                  <span class="stepper-label">到場 (等${topFastest.waitAtStopMin}分)</span>
                </div>
                <div class="stepper-arrow">
                  <span style="color: #BE123C;">投遞</span>
                  <span style="font-size: 13px;">➔</span>
                </div>
                <div class="stepper-node">
                  <span class="stepper-time" style="color: #BE123C; font-size: 17px; font-weight: 900;">${topFastest.time}</span>
                  <span class="stepper-label" style="color: #9F1239; font-weight: 900;">車到搞定</span>
                </div>
              </div>

              <div class="card-meta-grid">
                <div class="meta-item">
                  <span class="meta-label">服務項目</span>
                  <span class="meta-val" style="color: ${topFastest.hasRecycling ? '#059669' : '#64748B'};">${topFastest.hasRecycling ? '♻️ 垃圾+回收雙收' : '🗑️ 純一般垃圾'}</span>
                </div>
                <div class="meta-item">
                  <span class="meta-label">${profile.name}作戰距離</span>
                  <span class="meta-val">${topFastest.dist} 公尺 (${topFastest.travelMin} 分鐘)</span>
                </div>
                <div class="meta-item">
                  <span class="meta-label">出勤車號</span>
                  <span class="meta-val">${topFastest.plate}</span>
                </div>
                <div class="meta-item">
                  <span class="meta-label">路線生活圈</span>
                  <span class="meta-val" style="font-size: 13px; color: #475569;">${topFastest.routeName}</span>
                </div>
              </div>
              <a class="nav-btn nav-btn-fastest" href="https://www.google.com/maps/dir/?api=1&destination=${topFastest.lat},${topFastest.lon}&travelmode=${profile.gmapMode}" target="_blank">
                ${profile.icon} 一鍵開啟 Google Maps ${profile.name}導航
              </a>
              <button onclick="shareToLine('${topFastest.name}', '${topFastest.time}', ${topFastest.waitAtStopMin}, ${topFastest.dist})" style="width: 100%; background: #F8FAFC; color: #1E293B; border: 1.5px solid #CBD5E1; padding: 12px; border-radius: 14px; font-size: 14px; font-weight: 800; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 46px;">
                📲 一鍵把這班車分享給家人 (LINE)
              </button>
            </div>
          </div>
        `;
      } else if (topFastest && shiftState === 'DAY_PREVIEW') {
        cardsContainer.innerHTML += `
          <div class="card card-fastest" style="border-color: #EF4444;">
            <div class="card-tag tag-fastest">🥇 白天離峰時段・傍晚首班出勤預報</div>
            <div class="card-title-row">
              <div class="stop-name">${topFastest.name}</div>
              <div style="background: #FEE2E2; color: #DC2626; font-size: 13px; font-weight: 700; padding: 4px 10px; border-radius: 999px;">
                傍晚 ${topFastest.time} 起跑
              </div>
            </div>
            <div style="font-size: 13px; color: var(--text-sub); line-height: 1.4;">
              台東市今日垃圾車約於 ${earliestTimeStr} ~ ${latestTimeStr} 陸續出勤。您預計的時間若不在傍晚，週一二四五早晨（07:30~08:30）可至定點收運站倒垃圾！
            </div>
            <div class="card-meta-grid">
              <div class="meta-item">
                <span class="meta-label">傍晚首班車號</span>
                <span class="meta-val">${topFastest.plate}</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">服務項目</span>
                <span class="meta-val">${topFastest.hasRecycling ? '♻️ 垃圾+回收雙收' : '🗑️ 純一般垃圾'}</span>
              </div>
            </div>
            <a class="nav-btn nav-btn-fastest" href="https://www.google.com/maps/dir/?api=1&destination=${topFastest.lat},${topFastest.lon}&travelmode=${profile.gmapMode}" target="_blank">
              📍 預先查看站點地圖位置
            </a>
          </div>
        `;
      }

      // 5. 渲染 卡片 2：離家最近（第 5 項：只從表定時間 ≥ 出門時間挑最近；全部都過了就顯示「今日最近班次已過」；導航改用 profile.gmapMode）
      if (topNearest) {
        topNearest.travelMin = Math.max(1, Math.round(topNearest.dist / profile.speedMpm));


        topNearest.walkingMin = Math.max(1, Math.round(topNearest.dist / TRAVEL_PROFILES.walking.speedMpm));

        let badgeHtml = '';
        let distanceNoticeHtml = '';
        let waitHomeNoticeHtml = '';

        const waitMinutesAtHome = topNearest.stopMin - targetMinutes;
        if (waitMinutesAtHome > 20) {
          waitHomeNoticeHtml = `
            <div style="background: #F0FDF4; border: 1px solid #BBF7D0; border-radius: 12px; padding: 10px 14px; margin-bottom: 12px; font-size: 13px; color: #166534; line-height: 1.5;">
              🏠 <strong>離家最近班次提示：</strong> 此班車離家僅 <strong>${topNearest.dist}m</strong>，表定 <strong>${topNearest.time}</strong> 抵達。<br>
              距您預計時間還需等候約 <strong>${waitMinutesAtHome} 分鐘</strong>。若您想現在立刻搞定，請參考上方【最快完成】先鋒車次！
            </div>
          `;
        }

        if (currentTravelMode === 'walking') {
          if (topNearest.dist <= 400) {
            badgeHtml = `<div class="card-tag tag-nearest">🥈 步行最近・從容走去</div>`;
            distanceNoticeHtml = `<div style="font-size: 14px; font-weight: 700; color: #0284C7;">離家僅 ${topNearest.dist}m (${topNearest.walkingMin} 分鐘)</div>`;
          } else if (topNearest.dist <= 700) {
            badgeHtml = `<div class="card-tag tag-nearest" style="background: #E0F2FE; color: #0369A1; border: 1px solid #BAE6FD;">🥈 步行可達・快步前往</div>`;
            distanceNoticeHtml = `<div style="font-size: 14px; font-weight: 700; color: #D97706;">離家 ${topNearest.dist}m (${topNearest.walkingMin} 分鐘)</div>`;
          } else {
            badgeHtml = `<div class="card-tag" style="background: #FEF3C7; color: #B45309; border: 1px solid #FDE68A;">⚠️ 步行距離過遠・手提沉重</div>`;
            distanceNoticeHtml = `<div style="font-size: 14px; font-weight: 700; color: #DC2626;">離家約 ${topNearest.dist}m (${topNearest.walkingMin} 分鐘)</div>`;
          }
        } else {
          badgeHtml = `<div class="card-tag tag-nearest">🥈 離家最近・${profile.name}直達</div>`;
          distanceNoticeHtml = `<div style="font-size: 14px; font-weight: 700; color: #0284C7;">離家 ${topNearest.dist}m (${profile.name}約 ${topNearest.travelMin} 分鐘)</div>`;
        }

        cardsContainer.innerHTML += `
          <div class="card" ${currentTravelMode === 'walking' && topNearest.dist > 700 ? 'style="border-color: #FCD34D;"' : ''}>
            ${badgeHtml}
            <!-- F 項：卡片 2 表定與動態抵達並列 -->
            <div class="card-title-row">
              <div>
                <div class="stop-name">${topNearest.name}</div>
                ${distanceNoticeHtml}
              </div>
              <div style="display: flex; gap: 6px; align-items: stretch;">
                <div style="text-align: right; background: #F8FAFC; padding: 6px 10px; border-radius: 12px; border: 1px solid #E2E8F0; min-width: 76px;">
                  <div style="font-size: 10px; color: #475569; font-weight: 700;">車次表定</div>
                  <div style="font-size: 17px; font-weight: 900; color: #1E293B; line-height: 1.1;">${topNearest.time}</div>
                </div>
                <div style="text-align: right; background: #F0FDF4; padding: 6px 10px; border-radius: 12px; border: 1px solid #BBF7D0; min-width: 82px;">
                  <div style="font-size: 10px; color: #166534; font-weight: 700;">預估抵達</div>
                  <div style="font-size: 14px; font-weight: 900; color: #15803D; line-height: 1.2; margin-top: 2px;">${topNearest.officialEst || '依官方表定'}</div>
                </div>
              </div>
            </div>

            
              ${topFastest.isEarlyWarning ? `
                <div style="background: #FEF3C7; border: 1px solid #FCD34D; border-radius: 10px; padding: 6px 12px; margin-bottom: 10px; font-size: 12px; color: #92400E; font-weight: 700; display: flex; align-items: center; gap: 6px;">
                  <span>⚠️</span>
                  <span>車可能提早到，建議提早 15 分鐘出門</span>
                </div>
              ` : ''}

              ${topFastest.liveTruck ? `
                <div style="background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 10px; padding: 6px 12px; margin-bottom: 10px; font-size: 12px; color: #1E40AF; font-weight: 700; display: flex; align-items: center; gap: 6px;">
                  <span>🛰️</span>
                  <span>雷達已鎖定執勤車號：<strong>${topFastest.plate}</strong>（即時車距約 <strong>${haversine(currentLat, currentLon, topFastest.liveTruck.lat, topFastest.liveTruck.lon)}m</strong>，時速 ${Math.round(topFastest.liveTruck.speed || 0)} km/h）</span>
                </div>
              ` : ''}

            ${waitHomeNoticeHtml}
            
            ${currentTravelMode === 'walking' && topNearest.dist > 700 ? `
              <div style="background: #FFFBEB; border: 1px solid #FDE68A; border-radius: 12px; padding: 10px 14px; margin-bottom: 12px; font-size: 13px; color: #92400E; line-height: 1.5;">
                <strong>💡 生活管家貼心提醒：</strong><br>
                最近站點步行需 <strong>${topNearest.walkingMin} 分鐘</strong>，提重物走路非常吃力！<br>
                建議切換上方為【🛵 騎機車】（約 <strong>${Math.max(1, Math.round(topNearest.dist / TRAVEL_PROFILES.scooter.speedMpm))} 分鐘</strong> 抵達），或直接預約下方【生活管家 999 包月到府代倒】。
              </div>
            ` : ''}

            <div class="card-meta-grid">
              <div class="meta-item">
                <span class="meta-label">表定清運時間</span>
                <span class="meta-val">${topNearest.time}</span>
                ${topNearest.isOffline ? '<div style="font-size:10px; color:#D97706; font-weight:700; margin-top:2px;">⚠️ 離線表定，可能不準</div>' : ''}
              </div>
              <div class="meta-item">
                <span class="meta-label">清運服務</span>
                <span class="meta-val" style="color: ${topNearest.hasRecycling ? '#059669' : '#64748B'};">${topNearest.hasRecycling ? '♻️ 垃圾+回收' : '🗑️ 僅垃圾'}</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">${profile.name}距離</span>
                <span class="meta-val">${topNearest.dist}m (${topNearest.travelMin}分)</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">車次/路線</span>
                <span class="meta-val">${topNearest.plate}</span>
              </div>
            </div>
            <a class="nav-btn secondary" href="https://www.google.com/maps/dir/?api=1&destination=${topNearest.lat},${topNearest.lon}&travelmode=${profile.gmapMode}" target="_blank">
              ${profile.icon} ${profile.name}導航 (${topNearest.travelMin} 分鐘)
            </a>
          </div>
        `;
      } else {
        // 第 5 項：全部都過了就顯示「今日最近班次已過」
        cardsContainer.innerHTML += `
          <div class="card" style="border-color: #CBD5E1;">
            <div class="card-tag tag-nearest" style="background: #64748B;">🥈 今日最近班次已過</div>
            <div class="card-title-row">
              <div class="stop-name">今日最近班次已過</div>
            </div>
            <div style="font-size: 13px; color: var(--text-sub); line-height: 1.5;">
              您預計出門時間（${targetTimeStr}）之後，今日已無後續停靠班次。建議查看定點收運站資訊，或直接預約下方【生活管家 999 包月到府代倒】由專人到府收運！
            </div>
          </div>
        `;
      }

      // 6. 渲染 卡片 3：早晨定點收運 (第 4 項：檢查隔天星期，若隔天不開顯示「下一個開放日 X 07:30」並導流 999 代倒)
      if (topFixed && shiftState !== 'NIGHT_CLOSED') {
        cardsContainer.innerHTML += `
          <div class="card">
            <div class="card-tag tag-fixed">🥉 錯過夜間車救急・${fixedOpenInfo.pillText}</div>
            <div class="card-title-row">
              <div class="stop-name">${topFixed.name}</div>
            </div>
            ${fixedOpenInfo.noticeHtml}
            <div class="card-meta-grid">
              <div class="meta-item">
                <span class="meta-label">${fixedOpenInfo.rightBoxLabel}</span>
                <span class="meta-val" style="color: #D97706;">${fixedOpenInfo.isTomorrowOpen ? '07:30 - 08:30' : fixedOpenInfo.rightBoxValue + ' - 08:30'}</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">距離目前位置</span>
                <span class="meta-val">${topFixed.dist} 公尺 (${profile.name}約 ${topFixed.travelMin} 分鐘)</span>
              </div>
            </div>
            <a class="nav-btn secondary" href="https://www.google.com/maps/dir/?api=1&destination=${topFixed.lat},${topFixed.lon}&travelmode=${profile.gmapMode}" target="_blank">
              ${fixedOpenInfo.navBtnText(topFixed.name)}
            </a>
          </div>
        `;
      }

      // 條目 11.c：只抓候選站所在的那幾條路線 (用 route_id 裡的 run_id)，不抓全部 20 條
      const candidateRunIds = [];
      if (topFastest && topFastest.runId) candidateRunIds.push(topFastest.runId);
      if (topNearest && topNearest.runId && !candidateRunIds.includes(topNearest.runId)) candidateRunIds.push(topNearest.runId);

      if (candidateRunIds.length > 0) {
        const missingRunIds = candidateRunIds.filter(rid => !liveRouteSchedules[rid] || (Date.now() - liveRouteSchedules[rid].timestamp >= SCHEDULE_CACHE_TTL));
        if (missingRunIds.length > 0) {
          Promise.all(missingRunIds.map(rid => fetchRouteSchedule(rid))).then(results => {
            if (results && results.some(Boolean)) {
              renderRadar();
            }
          }).catch(() => {});
        }
      }
    }

    // LINE LIFF 雙模引擎 (生活管家專屬 LIFF ID: 2012513387-UT7yDt1M)
    const LIFF_ID = "2012513387-UT7yDt1M";
    let liffProfile = null;

    async function initLiff() {
      if (typeof liff === 'undefined') return;
      try {
        await liff.init({ liffId: LIFF_ID });
        if (liff.isLoggedIn()) {
          liffProfile = await liff.getProfile();
          const nameEl = document.getElementById('userDisplayName');
          if (nameEl && liffProfile.displayName) {
            nameEl.innerText = `👋 您好，${liffProfile.displayName}！`;
            nameEl.style.display = 'inline-block';
          }
        }
      } catch (err) {
        console.warn("LIFF init skipped or fallback to web:", err);
      }
    }

    async function shareToLine(name, time, waitMin, dist) {
      const shareUrl = `https://liff.line.me/${LIFF_ID}`;
      const msg = `🚨【生活管家・台東倒垃圾快報】\n今晚最快班次：${name}\n⏰ 表定抵達：${time}\n📍 距離目前約 ${dist}m (現場等約 ${waitMin} 分鐘)\n\n👉 點此查看即時清運雷達：\n${shareUrl}`;
      if (typeof liff !== 'undefined' && liff.isApiAvailable && liff.isApiAvailable('shareTargetPicker')) {
        try {
          await liff.shareTargetPicker([{ type: 'text', text: msg }]);
        } catch (e) {
          console.warn("share error:", e);
        }
      } else {
        if (navigator.clipboard) {
          navigator.clipboard.writeText(msg).then(() => {
            alert("已為您複製這班垃圾車資訊！可直接貼在 LINE 傳給家人。");
          });
        } else {
          alert(`請手動複製給家人：\n${msg}`);
        }
      }
    }

    // 第 7 項：每 45 秒自動抓一次即時位置，抓到後只更新徽章
    setInterval(() => {
      fetchLiveTruckLocations(true);
    }, 45000);

    // 初始化流程：先設置預設時間、渲染初始卡片，隨後自動嘗試手機 GPS 定位與 LIFF
    // 路線資料外部化：資料檔放在 data/，更新資料時請同步修改 DATA_VERSION，避免手機讀到舊快取
    const DATA_VERSION = "20261117_v2";

    async function loadRouteData() {
      const load = async (file) => {
        const res = await fetch(`data/${file}?v=${DATA_VERSION}`);
        if (!res.ok) throw new Error(`${file} HTTP ${res.status}`);
        return res.json();
      };
      const [garbage, recycling, fixed] = await Promise.all([
        load('garbage_routes.json'),
        load('recycling_routes.json'),
        load('fixed_stations.json')
      ]);
      LOCAL_SEED_ROUTES = garbage;
      RECYCLING_SEED_ROUTES = recycling;
      FIXED_STATIONS = fixed;
    }

    async function bootstrap() {
      const cards = document.getElementById('cardsContainer');
      if (cards) cards.innerHTML = '<div class="card" style="text-align:center; color:#64748B;">⏳ 正在載入台東清運路線資料...</div>';
      try {
        await loadRouteData();
      } catch (err) {
        console.error('Route data load failed:', err);
        if (cards) cards.innerHTML = '<div class="card" style="border-color:#DC2626; color:#991B1B;"><strong>⚠️ 路線資料載入失敗</strong><br>請確認網路連線後重新整理頁面。</div>';
        initLiff();
        return;
      }
      initTimeInput();
      prefetchTodaySchedules();
      renderRadar();
      if (navigator.geolocation) {
        requestLocation();
      }
      initLiff();
    }

    bootstrap();
  </script>
</body>
</html>
