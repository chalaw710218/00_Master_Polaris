<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>生活管家・一鍵倒垃圾雷達</title>
  <meta name="theme-color" content="#10B981">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <!-- LINE LIFF 官方 SDK (生活管家雙模引擎) -->
  <script charset="utf-8" src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
  <style>
    :root {
      --primary: #059669;
      --primary-light: #D1FAE5;
      --primary-dark: #065F46;
      --accent-orange: #EA580C;
      --accent-orange-bg: #FFEDD5;
      --bg: #F8FAFC;
      --card-bg: #FFFFFF;
      --text-main: #0F172A;
      --text-sub: #334155;
      --text-muted: #64748B;
      --border: #E2E8F0;
      --danger: #DC2626;
      --danger-bg: #FEE2E2;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans TC", sans-serif;
    }

    body {
      background-color: var(--bg);
      color: var(--text-main);
      padding: 16px;
      padding-bottom: 80px;
      display: flex;
      justify-content: center;
      -webkit-font-smoothing: antialiased;
    }

    .app-container {
      width: 100%;
      max-width: 480px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* 頂部生活管家標頭 - 包浩斯深邃漸層與雷達儀表板 */
    .header-card {
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
      color: #FFFFFF;
      padding: 22px 20px;
      border-radius: 24px;
      box-shadow: 0 12px 28px -6px rgba(5, 150, 105, 0.35);
      display: flex;
      flex-direction: column;
      gap: 10px;
      position: relative;
      overflow: hidden;
    }

    .header-card::after {
      content: '';
      position: absolute;
      top: -50px;
      right: -50px;
      width: 140px;
      height: 140px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 70%);
      pointer-events: none;
    }

    .radar-status-bar {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(0, 0, 0, 0.16);
      padding: 5px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      color: #ECFDF5;
      width: fit-content;
      backdrop-filter: blur(4px);
    }

    .radar-pulse-dot {
      width: 8px;
      height: 8px;
      background-color: #34D399;
      border-radius: 50%;
      position: relative;
      flex-shrink: 0;
    }

    .radar-pulse-dot::after {
      content: '';
      position: absolute;
      top: -4px;
      left: -4px;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background-color: rgba(52, 211, 153, 0.5);
      animation: radarRing 1.8s infinite;
    }

    @keyframes radarRing {
      0% { transform: scale(0.6); opacity: 1; }
      100% { transform: scale(1.8); opacity: 0; }
    }

    .header-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255, 255, 255, 0.2);
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      width: fit-content;
      backdrop-filter: blur(4px);
    }

    .header-title {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -0.5px;
    }

    .header-sub {
      font-size: 14px;
      opacity: 0.95;
      line-height: 1.4;
    }

    /* 核心操作主盒：去粗邊框，改採光階漫射投影 (約瑟夫美學) */
    .control-card {
      background: #FFFFFF;
      border: 1px solid rgba(226, 232, 240, 0.8);
      border-radius: 20px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.04), 0 4px 6px -2px rgba(15, 23, 42, 0.02);
    }

    /* 一鍵定位大按鈕 */
    .gps-btn {
      background-color: #FFFFFF;
      color: var(--primary-dark);
      border: 2px solid #A7F3D0;
      padding: 14px 18px;
      border-radius: 16px;
      font-size: 16px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      transition: all 0.2s ease;
    }

    .gps-btn:active {
      transform: scale(0.98);
      background-color: var(--primary-light);
    }

    /* 快速生活圈選擇器 (若未開啟 GPS 容錯) */
    .area-selector {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 4px;
      scrollbar-width: none;
    }
    .area-selector::-webkit-scrollbar { display: none; }

    .area-chip {
      flex-shrink: 0;
      background-color: #FFFFFF;
      border: 1px solid var(--border);
      padding: 8px 14px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 600;
      color: var(--text-sub);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .area-chip.active {
      background-color: var(--primary);
      color: #FFFFFF;
      border-color: var(--primary);
      box-shadow: 0 2px 6px rgba(5, 150, 105, 0.25);
    }

    /* 狀態提示 (停收日 / 離線模式) */
    .alert-banner {
      padding: 14px 16px;
      border-radius: 14px;
      font-size: 14px;
      font-weight: 600;
      line-height: 1.4;
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    .alert-danger {
      background-color: var(--danger-bg);
      color: var(--danger);
      border: 1px solid #FECACA;
    }

    .alert-info {
      background-color: #EFF6FF;
      color: #1D4ED8;
      border: 1px solid #BFDBFE;
    }

    /* 交通工具切換器 - 磁吸控制台 (約瑟夫升級款) */
    .travel-track {
      display: flex;
      background: #F1F5F9;
      border-radius: 16px;
      padding: 5px;
      gap: 6px;
    }

    .travel-chip {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 10px 8px;
      border-radius: 12px;
      background: transparent;
      border: 1px solid transparent;
      cursor: pointer;
      color: var(--text-sub);
      font-size: 14px;
      font-weight: 700;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .travel-chip.active {
      background: #FFFFFF;
      color: #065F46;
      border-color: rgba(5, 150, 105, 0.2);
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
      font-weight: 900;
      transform: translateY(-1px);
    }

    /* 核心決策卡片 - 約瑟夫極致光學版 */
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 20px;
      box-shadow: 0 8px 20px -4px rgba(15, 23, 42, 0.04), 0 4px 6px -2px rgba(15, 23, 42, 0.02);
      display: flex;
      flex-direction: column;
      gap: 14px;
      position: relative;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card-fastest {
      border: 2px solid #EF4444;
      background: #FFFFFF;
      box-shadow: 0 16px 36px -8px rgba(220, 38, 38, 0.22), 0 4px 12px rgba(220, 38, 38, 0.08);
      overflow: hidden;
      padding: 0;
    }

    .card-fastest-banner {
      background: linear-gradient(135deg, #DC2626 0%, #991B1B 100%);
      color: #FFFFFF;
      padding: 14px 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .card-fastest-content {
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .card-tag {
      align-self: flex-start;
      padding: 4px 10px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.5px;
    }

    .tag-fastest {
      background-color: #DC2626;
      color: #FFFFFF;
      box-shadow: 0 2px 6px rgba(220, 38, 38, 0.3);
    }

    .tag-nearest {
      background-color: #0284C7;
      color: #FFFFFF;
      box-shadow: 0 2px 6px rgba(2, 132, 199, 0.3);
    }

    .tag-fixed {
      background-color: #D97706;
      color: #FFFFFF;
      box-shadow: 0 2px 6px rgba(217, 119, 6, 0.3);
    }

    .card-title-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
    }

    .stop-name {
      font-size: 19px;
      font-weight: 800;
      color: var(--text-main);
      line-height: 1.3;
      letter-spacing: -0.3px;
    }

    .countdown-pill {
      background: #DC2626;
      color: #FFFFFF;
      font-size: 13px;
      font-weight: 800;
      padding: 5px 12px;
      border-radius: 999px;
      animation: pulse 1.6s infinite;
      white-space: nowrap;
      box-shadow: 0 2px 8px rgba(220, 38, 38, 0.35);
    }

    @keyframes pulse {
      0% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.88; transform: scale(1.03); }
      100% { opacity: 1; transform: scale(1); }
    }

    /* 光學時間軸步進器 (約瑟夫三點一線節奏軸) */
    .stepper-container {
      background: #FFF1F2;
      border: 1px solid #FECDD3;
      border-radius: 14px;
      padding: 12px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }

    .stepper-node {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      flex: 1;
    }

    .stepper-time {
      font-size: 14px;
      font-weight: 800;
      color: #9F1239;
      letter-spacing: -0.3px;
    }

    .stepper-label {
      font-size: 11px;
      font-weight: 700;
      color: #BE123C;
      opacity: 0.9;
    }

    .stepper-arrow {
      display: flex;
      flex-direction: column;
      align-items: center;
      font-size: 11px;
      font-weight: 800;
      color: #E11D48;
      flex-shrink: 0;
      line-height: 1.2;
    }

    .card-meta-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      background: rgba(255, 255, 255, 0.9);
      padding: 12px;
      border-radius: 14px;
      border: 1px solid rgba(0, 0, 0, 0.05);
    }
      font-weight: 800;
      letter-spacing: 0.5px;
    }

    .tag-fastest {
      background-color: #DC2626;
      color: #FFFFFF;
    }

    .tag-nearest {
      background-color: #0284C7;
      color: #FFFFFF;
    }

    .tag-fixed {
      background-color: #D97706;
      color: #FFFFFF;
    }

    .card-title-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .stop-name {
      font-size: 18px;
      font-weight: 800;
      color: var(--text-main);
      line-height: 1.3;
    }

    .countdown-pill {
      background: #DC2626;
      color: #FFFFFF;
      font-size: 13px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 999px;
      animation: pulse 1.5s infinite;
      white-space: nowrap;
    }

    @keyframes pulse {
      0% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.85; transform: scale(1.03); }
      100% { opacity: 1; transform: scale(1); }
    }

    .card-meta-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      background: rgba(255, 255, 255, 0.8);
      padding: 10px;
      border-radius: 12px;
      border: 1px solid rgba(0, 0, 0, 0.04);
    }

    .meta-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .meta-label {
      font-size: 12px;
      color: var(--text-sub);
    }

    .meta-val {
      font-size: 15px;
      font-weight: 700;
      color: var(--text-main);
    }

    /* 一鍵導航按鈕 (48px 高，長輩大拇指防呆) */
    .nav-btn {
      background-color: var(--primary);
      color: #FFFFFF;
      text-decoration: none;
      padding: 13px;
      border-radius: 14px;
      font-size: 15px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      min-height: 48px;
      box-shadow: 0 3px 8px rgba(5, 150, 105, 0.25);
    }

    .nav-btn:active {
      background-color: var(--primary-dark);
      transform: scale(0.99);
    }

    .nav-btn.nav-btn-fastest {
      background-color: #DC2626;
      box-shadow: 0 4px 12px rgba(220, 38, 38, 0.35);
    }

    .nav-btn.nav-btn-fastest:active {
      background-color: #B91C1C;
    }

    .nav-btn.secondary {
      background-color: #F1F5F9;
      color: #334155;
      box-shadow: none;
    }

    /* 商業導流轉化卡 (生活管家 999 包月) */
    .upsell-card {
      background: linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%);
      border: 2px dashed #FB923C;
      border-radius: 18px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .upsell-badge {
      color: #C2410C;
      font-size: 12px;
      font-weight: 800;
    }

    .upsell-title {
      font-size: 17px;
      font-weight: 800;
      color: #9A3412;
      line-height: 1.3;
    }

    .upsell-desc {
      font-size: 13px;
      color: #7C2D12;
      line-height: 1.5;
    }

    .upsell-btn {
      background: #EA580C;
      color: #FFFFFF;
      text-decoration: none;
      padding: 13px;
      border-radius: 12px;
      font-size: 15px;
      font-weight: 700;
      text-align: center;
      box-shadow: 0 3px 8px rgba(234, 88, 12, 0.3);
    }

    .upsell-btn:active {
      background: #C2410C;
    }

    /* 頁尾小字 */
    .footer-note {
      text-align: center;
      font-size: 12px;
      color: #94A3B8;
      line-height: 1.5;
      margin-top: 10px;
    }
  </style>
</head>
<body>

  <div class="app-container">

    <!-- 頂部生活管家標頭 - 包浩斯深邃漸層與雷達儀表板 -->
    <header class="header-card">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div class="radar-status-bar">
          <span class="radar-pulse-dot"></span>
          <span id="userDisplayName" style="display:none; margin-right: 2px; font-weight:800; color: #FDE047;"></span>
          <span>台東即時清運雷達已在線</span>
        </div>
        <div class="header-badge" style="background: rgba(0,0,0,0.18);">
          <span>⏱️</span>
          <span id="liveClock">--:--</span>
        </div>
      </div>
      <h1 class="header-title" style="display: flex; align-items: center; gap: 8px;">
        <span>一鍵倒垃圾雷達</span>
        <span style="font-size: 12px; background: rgba(255,255,255,0.25); padding: 3px 8px; border-radius: 8px; font-weight: 800; letter-spacing: 0.5px;">PRO</span>
      </h1>
      <p class="header-sub">秒查離你最近、最快出門的垃圾車，不再慌張追車！</p>
    </header>

    <!-- 核心操作盒：去粗邊框，改採光階漫射投影 (約瑟夫美學) -->
    <section class="control-card">
      
      <!-- 定位方式雙軌選擇：【🎯 自動定位】 vs 【✏️ 手動輸入地址】 (創辦人指定雙軌) -->
      <div style="display: flex; flex-direction: column; gap: 8px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
        <div style="display: flex; gap: 6px;">
          <button id="tabGpsBtn" onclick="switchLocMode('gps')" class="area-chip active" style="flex: 1; text-align: center; font-size: 14px; padding: 10px; font-weight: 800;">
            🎯 手機自動定位
          </button>
          <button id="tabManualBtn" onclick="switchLocMode('manual')" class="area-chip" style="flex: 1; text-align: center; font-size: 14px; padding: 10px; font-weight: 800;">
            ✏️ 手動輸入地址
          </button>
        </div>

        <!-- 模式 A：GPS 自動定位狀態列 -->
        <div id="gpsView" style="display: flex; justify-content: space-between; align-items: center; background: #F8FAFC; padding: 10px 12px; border-radius: 12px;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 18px;">📍</span>
            <div>
              <div style="font-size: 11px; color: var(--text-sub); font-weight: 600;">出發點 (手機 GPS)</div>
              <div id="currentLocationText" style="font-size: 14px; font-weight: 800; color: var(--text-main);">正在抓取手機 GPS...</div>
            </div>
          </div>
          <button id="gpsTriggerBtn" onclick="requestLocation()" style="background: var(--primary-light); color: var(--primary-dark); border: 1px solid #A7F3D0; padding: 6px 12px; border-radius: 999px; font-size: 12px; font-weight: 700; cursor: pointer;">
            🔄 刷新定位
          </button>
        </div>

        <!-- 模式 B：手動輸入地址/路名輸入框 -->
        <div id="manualView" style="display: none; flex-direction: column; gap: 6px;">
          <div style="display: flex; gap: 8px;">
            <input type="text" id="manualAddressInput" placeholder="輸入台東路名或地標 (如：寶桑路、正氣路)" onkeydown="if(event.key==='Enter') searchManualAddress()" style="flex: 1; height: 46px; font-size: 15px; font-weight: 700; background: #F8FAFC; border: 2px solid #CBD5E1; border-radius: 12px; padding: 0 12px; outline: none;">
            <button onclick="searchManualAddress()" style="height: 46px; padding: 0 16px; background: #059669; color: #FFFFFF; border: none; border-radius: 12px; font-size: 14px; font-weight: 700; cursor: pointer; white-space: nowrap;">
              🔍 定位
            </button>
          </div>
          <div id="manualSearchNotice" style="font-size: 11px; color: #059669; font-weight: 600;">
            💡 支援台東各路段：正氣路、中華路、更生路、傳廣路、四維路、寶桑路、鐵花路等
          </div>
        </div>
      </div>

      <!-- 倒垃圾時間自選與快捷鍵 -->
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <label for="trashTimeInput" style="font-size: 14px; font-weight: 800; color: var(--text-main);">
            ⏰ 您預計幾點去倒垃圾？
          </label>
          <span id="timeRelativeDesc" style="color: #059669; font-size: 13px; font-weight: 700;">(指定時間)</span>
        </div>
        
        <div style="display: flex; gap: 8px; align-items: center;">
          <input type="time" id="trashTimeInput" onchange="onTimeInputChange()" style="flex: 1; height: 50px; font-size: 22px; font-weight: 800; color: var(--text-main); background: #F8FAFC; border: 2px solid #CBD5E1; border-radius: 14px; padding: 0 14px; outline: none; text-align: center;">
          <button onclick="setNowTime()" style="height: 50px; padding: 0 16px; background: #059669; color: #FFFFFF; border: none; border-radius: 14px; font-size: 15px; font-weight: 700; white-space: nowrap; cursor: pointer; display: flex; align-items: center; gap: 4px;">
            ⚡ 就是現在
          </button>
        </div>

        <!-- 常用時段一鍵快捷切換 -->
        <div style="display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding-top: 4px;">
          <button class="area-chip" onclick="quickSetTime('16:45')">🕔 16:45</button>
          <button class="area-chip" onclick="quickSetTime('17:15')">🕠 17:15</button>
          <button class="area-chip" onclick="quickSetTime('18:00')">🕕 18:00</button>
          <button class="area-chip" onclick="quickSetTime('18:30')">🕡 18:30</button>
          <button class="area-chip" onclick="quickSetTime('19:00')">🕖 19:00</button>
        </div>

        <!-- 交通工具切換：【🚶 步行】 vs 【🛵 騎機車 (台東首選)】 vs 【🚗 開車】 (創辦人指引) -->
        <div style="display: flex; flex-direction: column; gap: 8px; padding-top: 4px;">
          <label style="font-size: 13px; font-weight: 800; color: var(--text-main); display: flex; justify-content: space-between; align-items: center;">
            <span>🛵 出門交通工具 (動態算路程)</span>
            <span id="travelModeDesc" style="color: #059669; font-weight: 800; font-size: 12px; background: #ECFDF5; padding: 2px 8px; border-radius: 6px;">(騎機車約 30km/h)</span>
          </label>
          <div class="travel-track">
            <button id="modeWalkBtn" onclick="setTravelMode('walking')" class="travel-chip area-chip">
              <span style="font-size: 16px;">🚶</span>
              <span>步行</span>
            </button>
            <button id="modeScooterBtn" onclick="setTravelMode('scooter')" class="travel-chip area-chip active">
              <span style="font-size: 16px;">🛵</span>
              <span>騎機車</span>
            </button>
            <button id="modeCarBtn" onclick="setTravelMode('car')" class="travel-chip area-chip">
              <span style="font-size: 16px;">🚗</span>
              <span>開車</span>
            </button>
          </div>
        </div>

        <!-- 資源回收勾選開關 (創辦人指示：默認只倒垃圾；勾選則強制匹配垃圾+回收雙收車) -->
        <div style="background: #F8FAFC; border: 2px solid #E2E8F0; border-radius: 14px; padding: 10px 14px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; transition: all 0.2s;" id="recycleBox" onclick="toggleRecycle(event)">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 22px;">♻️</span>
            <div>
              <div style="font-size: 14px; font-weight: 800; color: var(--text-main);" id="recycleTitleText">我也要倒「資源回收」</div>
              <div style="font-size: 11px; color: var(--text-sub);" id="recycleSubText">未勾選默認只倒垃圾；勾選後只顯示【垃圾+回收雙收】車次</div>
            </div>
          </div>
          <input type="checkbox" id="recycleCheckbox" onchange="onRecycleChange()" style="width: 22px; height: 22px; accent-color: #059669; cursor: pointer;">
        </div>
      </div>

    </section>

    <!-- 狀態警報 (例：台東在地週三/週日停收) -->
    <div id="alertContainer"></div>

    <!-- 決策卡片容器 -->
    <main id="cardsContainer" style="display: flex; flex-direction: column; gap: 14px;">
      <!-- 卡片內容將由 JavaScript 動態渲染 -->
    </main>

    <!-- 商業導流轉化卡 (生活管家 999/1999 包月真實登記入口) -->
    <section class="upsell-card" id="upsellCard">
      <div class="upsell-badge">💡 生活管家・台東到府代倒專案</div>
      <div class="upsell-title">追垃圾車好喘、下雨天又狼狽？</div>
      <div class="upsell-desc">
        這輩子，別再為了追垃圾車中斷晚餐狼狽衝刺了！<br>
        生活管家為您每週到府門前代收，一般垃圾 ＋ 資源回收一次搞定：<br>
        • <strong>999 輕量包</strong>：每週 2 次，適合小家庭與上班族<br>
        • <strong>1,999 旗艦包</strong>：每週 5 次（台東清潔隊收運日天天出勤）<br>
        🛵 專人到府人力代提 • 卸箱出勤100%食安隔離 • 門前保潔拍照回報
      </div>
      <a class="upsell-btn" href="https://docs.google.com/forms/d/e/1FAIpQLSchOskqPJfVtCVVEZpZuN2cHODjdAGSjyp184GkDpbFs-cqvw/viewform" target="_blank">
        👉 點我立即線上登記預約 (Google 表單)
      </a>
    </section>

    <footer class="footer-note">
      生活的一部分，就醬點！生活管家團隊 溫暖守護<br>
      資料來源：台東市清潔隊公開路線表 ✕ 清運e點通動態邏輯
    </footer>

  </div>

  <script>
    // ==========================================
    // 🛰️ 即時車機 GPS ✕ 動態 ETA 計算引擎 (PLAN-LB-TRASH-RADAR-01 修補版)
    // ==========================================
    let liveTrucksCache = {}; // { [normKey]: { car_no, name, run_id, lat, lon, speed, time, status, lastUpdate, visitedStops: {} } }
    let lastLiveFetchTimestamp = 0;
    let isFetchingLiveGps = false;

    // 第 8 項：統一車號格式（去掉括號備註、去掉「-」與空白、轉大寫）
    function normalizePlate(plateStr) {
      if (!plateStr) return "";
      return String(plateStr)
        .replace(/\(.*?\)/g, "")
        .replace(/（.*?）/g, "")
        .replace(/^回/, "")
        .replace(/[-\s]/g, "")
        .toUpperCase();
    }

    function makeStopKey(lat, lon) {
      return `${Number(lat).toFixed(5)},${Number(lon).toFixed(5)}`;
    }

    // 第 6 項：改用自家 Cloudflare Worker 為第一順位，公共代理保留為備援
    const CF_WORKER_URL = "https://taitung-trash-proxy.chalaw710218.workers.dev";
    const LIVE_GPS_PROXIES = [
      (target) => `${CF_WORKER_URL}/?url=${encodeURIComponent(target)}`,
      (target) => `https://api.allorigins.win/raw?url=${encodeURIComponent(target)}`,
      (target) => `https://corsproxy.io/?url=${encodeURIComponent(target)}`
    ];

    async function fetchLiveTruckLocations(forceByInterval = false) {
      const now = Date.now();
      // 45 秒防抖保護 (若為每 45 秒定時器觸發則允許執行)
      if ((!forceByInterval && now - lastLiveFetchTimestamp < 45000) || isFetchingLiveGps) {
        return;
      }
      isFetchingLiveGps = true;

      const targetUrl = "https://www.bstruck.hinet.net/MIS/subsystem/XML/Appcarlocation.ashx?customer_id=22&key=1";

      for (let i = 0; i < LIVE_GPS_PROXIES.length; i++) {
        try {
          const proxyUrl = LIVE_GPS_PROXIES[i](targetUrl);
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 6000);

          const res = await fetch(proxyUrl, { signal: controller.signal });
          clearTimeout(timeoutId);

          if (!res.ok) continue;
          const xmlText = await res.text();
          if (!xmlText || (!xmlText.includes("<Items>") && !xmlText.includes("<Items/>") && !xmlText.includes("<Items />"))) continue;

          // XML 解析
          const parser = new DOMParser();
          const xmlDoc = parser.parseFromString(xmlText, "text/xml");
          const carNodes = xmlDoc.getElementsByTagName("Car");

          const nextCache = { ...liveTrucksCache };
          for (let c = 0; c < carNodes.length; c++) {
            const node = carNodes[c];
            const rawCarNo = node.getAttribute("car_no") || "";
            const rawRouteName = node.getAttribute("name") || "";
            const runId = node.getAttribute("run_id") || "";
            const lat = parseFloat(node.getAttribute("lat"));
            const lon = parseFloat(node.getAttribute("lon"));
            const hasSpeedAttr = node.hasAttribute("speed");
            const status = node.getAttribute("car_status") || "執勤中";
            const speed = hasSpeedAttr ? parseFloat(node.getAttribute("speed") || "0") : (status === "執勤中" ? 15 : 0);
            const time = node.getAttribute("time") || "";

            if ((rawCarNo || rawRouteName) && !isNaN(lat) && !isNaN(lon)) {
              const normCar = normalizePlate(rawCarNo);
              const normRoute = normalizePlate(rawRouteName);
              const prevEntry = nextCache[normCar] || nextCache[normRoute] || nextCache[rawCarNo] || {};
              const visitedStops = { ...(prevEntry.visitedStops || {}) };

              // 第 1 項：檢查該車目前位置是否進入任何站點 120m 內，記錄於歷史欄位 visitedStops
              if (typeof LOCAL_SEED_ROUTES !== "undefined" && status !== "未執勤") {
                LOCAL_SEED_ROUTES.forEach(r => {
                  if (normalizePlate(r.truck_plate) === normCar || normalizePlate(r.route_name) === normRoute || (runId && r.route_id === `TT_OFFICIAL_${runId}`)) {
                    r.stops.forEach(st => {
                      if (haversine(lat, lon, st.lat, st.lon) <= 120) {
                        visitedStops[makeStopKey(st.lat, st.lon)] = true;
                      }
                    });
                  }
                });
              }

              const record = {
                car_no: rawCarNo,
                name: rawRouteName,
                run_id: runId,
                lat,
                lon,
                speed,
                time,
                status,
                lastUpdate: now,
                visitedStops
              };

              if (normCar) nextCache[normCar] = record;
              if (normRoute) nextCache[normRoute] = record;
              if (rawCarNo) nextCache[rawCarNo] = record;
              if (rawRouteName) nextCache[rawRouteName] = record;
            }
          }

          liveTrucksCache = nextCache;
          lastLiveFetchTimestamp = now;
          isFetchingLiveGps = false;

          // 第 7 項：抓到即時車況後，只微更新徽章（不重繪整頁）
          updateCardsWithLiveStatus();
          return;
        } catch (e) {
          console.warn(`Live GPS fetch proxy [${i}] error:`, e.message);
        }
      }

      isFetchingLiveGps = false;
      lastLiveFetchTimestamp = now;
    }

    // 條目 11：清運e點通官方動態清運班表快取 (run_id -> { timestamp, stops: { [name or key]: { stime, rawStime, estimate, statusId, carNo } } })
    let liveRouteSchedules = {};
    const SCHEDULE_CACHE_TTL = 30000; // 30 秒快取
    let isFetchingSchedule = {};

    async function fetchRouteSchedule(runId) {
      if (!runId) return null;
      const now = Date.now();
      if (liveRouteSchedules[runId] && (now - liveRouteSchedules[runId].timestamp < SCHEDULE_CACHE_TTL)) {
        return liveRouteSchedules[runId];
      }
      if (isFetchingSchedule[runId]) return null;
      isFetchingSchedule[runId] = true;

      const proxyBase = "https://taitung-trash-proxy.chalaw710218.workers.dev";
      const proxyUrl = `${proxyBase}/schedule?run_id=${runId}`;

      try {
        const res = await fetch(proxyUrl);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const xmlText = await res.text();
        if (!xmlText || !xmlText.includes("<ScheduleTime")) {
          isFetchingSchedule[runId] = false;
          return null;
        }

        const parser = new DOMParser();
        const xmlDoc = parser.parseFromString(xmlText, "text/xml");
        const items = xmlDoc.getElementsByTagName("ScheduleTime");
        if (!items || items.length === 0) {
          isFetchingSchedule[runId] = false;
          return null;
        }

        const stopMap = {};
        for (let i = 0; i < items.length; i++) {
          const node = items[i];
          const name = (node.getAttribute("name") || "").trim();
          const stime = (node.getAttribute("stime") || "").trim();
          const estimate = (node.getAttribute("estimate") || "").trim();
          const statusId = (node.getAttribute("status_id") || "").trim();
          const carNo = (node.getAttribute("car_no") || "").trim();
          const lat = parseFloat(node.getAttribute("lat"));
          const lon = parseFloat(node.getAttribute("lon"));

          let cleanStime = stime;
          if (stime.includes("~")) {
            cleanStime = stime.split("~")[0].trim();
          }

          const info = { name, stime: cleanStime, rawStime: stime, estimate, statusId, carNo, lat, lon };
          if (name) stopMap[name] = info;
          if (!isNaN(lat) && !isNaN(lon)) {
            stopMap[`${lat.toFixed(4)},${lon.toFixed(4)}`] = info;
            stopMap[`${lat},${lon}`] = info;
          }
        }

        liveRouteSchedules[runId] = {
          timestamp: now,
          stops: stopMap
        };
        isFetchingSchedule[runId] = false;
        return liveRouteSchedules[runId];
      } catch (err) {
        console.warn(`Fetch schedule for run ${runId} error:`, err ? err.message : err);
        isFetchingSchedule[runId] = false;
        return null;
      }
    }

    // 第 1 項、第 8 項 & 第 11 項：計算特定車輛對特定站點的即時動態 ETA 與清運狀態
    function evaluateLiveTruckStatus(plate, stopLat, stopLon, stopMin, runId, stopName) {
      // 條目 11.e & 11.b：優先檢查清運e點通官方動態班表與 estimate
      let officialStop = null;
      if (runId && liveRouteSchedules && liveRouteSchedules[runId] && liveRouteSchedules[runId].stops) {
        const stopsMap = liveRouteSchedules[runId].stops;
        if (stopName && stopsMap[stopName]) {
          officialStop = stopsMap[stopName];
        } else if (!isNaN(stopLat) && !isNaN(stopLon)) {
          officialStop = stopsMap[`${Number(stopLat).toFixed(4)},${Number(stopLon).toFixed(4)}`] || stopsMap[`${stopLat},${stopLon}`];
        }
      }

      // 條目 11.e：第 1 項的「已駛離」判斷，直接採用官方 estimate 的「已清運」，不再自己用車速推算
      if (officialStop && officialStop.estimate === "已清運") {
        return {
          hasLive: true,
          badgeColor: '#9A3412',
          badgeBg: '#FFEDD5',
          border: '#FDBA74',
          dotColor: '#EA580C',
          label: '⚠️ 車輛已駛離本站',
          detail: '清運e點通即時狀態：此站已清運完畢駛離！',
          delayMin: 0,
          isPassed: true
        };
      }

      // 條目 11.b：若官方有「已抵達」或「約X分到」
      if (officialStop && officialStop.estimate) {
        if (officialStop.estimate === "已抵達") {
          return {
            hasLive: true,
            badgeColor: '#065F46',
            badgeBg: '#D1FAE5',
            border: '#6EE7B7',
            dotColor: '#10B981',
            label: '🛑 垃圾車正在現場收運中！',
            detail: '清運e點通即時車機狀態：垃圾車已抵達現場！',
            delayMin: 0,
            isPassed: false
          };
        } else if (officialStop.estimate.includes("分到")) {
          return {
            hasLive: true,
            badgeColor: '#065F46',
            badgeBg: '#ECFDF5',
            border: '#A7F3D0',
            dotColor: '#10B981',
            label: `🟢 官方即時預估：${officialStop.estimate}`,
            detail: '清運e點通車機即時路況動態計算到站時間',
            delayMin: 0,
            isPassed: false
          };
        }
      }

      const normKey = normalizePlate(plate);
      const truck = (liveTrucksCache && (liveTrucksCache[normKey] || liveTrucksCache[plate])) || null;

      if (!truck || truck.status === "未執勤") {
        if (officialStop && officialStop.stime) {
          return {
            hasLive: false,
            badgeColor: '#2563EB',
            badgeBg: '#EFF6FF',
            border: '#BFDBFE',
            dotColor: '#3B82F6',
            label: '⚪ 依官方今日班表',
            detail: `今日表定 ${officialStop.stime}，車機目前離峰或尚未出勤`,
            delayMin: 0,
            isPassed: false
          };
        }
        return {
          hasLive: false,
          badgeColor: '#64748B',
          badgeBg: '#F1F5F9',
          border: '#E2E8F0',
          dotColor: '#94A3B8',
          label: '⚪ 依官方表定時間',
          detail: '車機目前離峰或尚未出勤',
          delayMin: 0,
          isPassed: false
        };
      }

      if (!truck.visitedStops) {
        truck.visitedStops = {};
      }

      const stopKey = makeStopKey(stopLat, stopLon);
      const dist = haversine(truck.lat, truck.lon, stopLat, stopLon);

      // 只要進入該站 120m 內，即寫入 visitedStops 歷史紀錄
      if (dist <= 120) {
        truck.visitedStops[stopKey] = true;
      }

      const hasVisited = Boolean(
        truck.visitedStops[stopKey] ||
        truck.visitedStops[`${stopLat},${stopLon}`]
      );

      // 市區垃圾車平均速度約 260 公尺/分鐘 (考量停等家戶投遞)
      const liveEtaMin = Math.max(1, Math.round(dist / 260));

      const now = (typeof window !== 'undefined' && window.__TEST_NOW__) ? new Date(window.__TEST_NOW__) : new Date();
      const currentMin = now.getHours() * 60 + now.getMinutes();
      const estArrivalMin = currentMin + liveEtaMin;
      const delayMin = estArrivalMin - stopMin;

      // 1. 車輛已過站判定：只有「曾到過該站 120m 內 (hasVisited) 且已離開 > 400m」才判已駛離！
      if (hasVisited && dist > 400) {
        return {
          hasLive: true,
          badgeColor: '#9A3412',
          badgeBg: '#FFEDD5',
          border: '#FDBA74',
          dotColor: '#EA580C',
          label: '⚠️ 車輛已駛離本站',
          detail: `車輛已通過該路段（目前距離 ${dist}m）`,
          delayMin: delayMin,
          isPassed: true,
          dist: dist,
          liveEtaMin: liveEtaMin
        };
      }

      // 若時間已過表定 > 2 分鐘且車距 > 400m，但「從未記錄到進入本站 120m 內 (!hasVisited)」
      // 無法確定是否已過站或晚到，一律顯示「依官方表定時間」
      if (currentMin > stopMin + 2 && dist > 400 && !hasVisited) {
        return {
          hasLive: false,
          badgeColor: '#64748B',
          badgeBg: '#F1F5F9',
          border: '#E2E8F0',
          dotColor: '#94A3B8',
          label: '⚪ 依官方表定時間',
          detail: '依官方班表時間為準',
          delayMin: delayMin,
          isPassed: false,
          dist: dist,
          liveEtaMin: liveEtaMin
        };
      }

      // 2. 現場收運中判定 (距離站點 120m 內且慢速/停等)
      if (dist <= 120 && (truck.speed === undefined || truck.speed <= 8)) {
        return {
          hasLive: true,
          badgeColor: '#065F46',
          badgeBg: '#D1FAE5',
          border: '#6EE7B7',
          dotColor: '#10B981',
          label: '🛑 垃圾車正在現場收運中！',
          detail: `垃圾車已在站點周邊（距此站 ${dist}m），請立即前往投遞！`,
          delayMin: delayMin,
          isPassed: false,
          dist: dist,
          liveEtaMin: 0
        };
      }

      // 3. 誤點情況判定 (比表定時間晚 4 分鐘以上)
      if (delayMin >= 4) {
        const estH = String(Math.floor(estArrivalMin / 60) % 24).padStart(2, '0');
        const estM = String(estArrivalMin % 60).padStart(2, '0');
        return {
          hasLive: true,
          badgeColor: '#9A3412',
          badgeBg: '#FFF7ED',
          border: '#FED7AA',
          dotColor: '#F97316',
          label: `🔴 預估稍有延誤 (${delayMin} 分鐘)`,
          detail: `沿途清運量較大，目前距離此站 ${dist}m，預計約 ${estH}:${estM} 抵達 (請從容出發，不必在路口吹風)`,
          delayMin: delayMin,
          isPassed: false,
          dist: dist,
          liveEtaMin: liveEtaMin
        };
      }

      // 4. 正常行駛接近中（條目 11：車在跑時，即時狀態不得是灰色的離峰）
      return {
        hasLive: true,
        badgeColor: '#065F46',
        badgeBg: '#ECFDF5',
        border: '#A7F3D0',
        dotColor: '#10B981',
        label: `🟢 即時動態：垃圾車行駛中`,
        detail: `距離此站約 ${dist}m，預估還有 ${liveEtaMin} 分鐘抵達`,
        delayMin: delayMin,
        isPassed: false,
        dist: dist,
        liveEtaMin: liveEtaMin
      };
    }

    // 第 7 項：當非同步取得即時車機後，僅微更新 DOM 中的即時徽章區塊 (零閃爍)
    function updateCardsWithLiveStatus() {
      const liveFastestEl = document.getElementById('liveFastestStatusBox');
      if (liveFastestEl && liveFastestEl.dataset.plate) {
        const p = liveFastestEl.dataset.plate;
        const lat = parseFloat(liveFastestEl.dataset.lat);
        const lon = parseFloat(liveFastestEl.dataset.lon);
        const sMin = parseInt(liveFastestEl.dataset.stopmin, 10);
        const runId = liveFastestEl.dataset.runid || "";
        const stopName = liveFastestEl.dataset.stopname || "";
        const status = evaluateLiveTruckStatus(p, lat, lon, sMin, runId, stopName);

        liveFastestEl.innerHTML = `
          <div style="display: flex; align-items: center; gap: 6px; font-weight: 800; font-size: 13px; color: ${status.badgeColor};">
            <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: ${status.dotColor}; animation: pulse 1.5s infinite;"></span>
            <span>${status.label}</span>
          </div>
          <div style="font-size: 12px; color: ${status.badgeColor}; opacity: 0.95; line-height: 1.4; margin-top: 2px;">
            ${status.detail}
          </div>
        `;
        liveFastestEl.style.backgroundColor = status.badgeBg;
        liveFastestEl.style.borderColor = status.border;
      }
    }

    // 第 4 項：計算定點收運站（只開週一、二、四、五 07:30-08:30）下一個開放日資訊
    function getNextFixedStationOpenInfo(currentDay) {
      const OPEN_DAYS = [1, 2, 4, 5];
      const DAY_NAMES = ["週日", "週一", "週二", "週三", "週四", "週五", "週六"];
      const tomorrow = (currentDay + 1) % 7;
      if (OPEN_DAYS.includes(tomorrow)) {
        return {
          isTomorrowOpen: true,
          nextDayName: DAY_NAMES[tomorrow],
          pillText: "明早 07:30 救急",
          cardTitlePrefix: "明日早晨救急首選・定點收運站",
          rightBoxLabel: "明日早晨開放",
          rightBoxValue: "07:30",
          navBtnText: (stationName) => `🧭 一鍵導航至明早定點站 (${stationName})`,
          noticeHtml: ""
        };
      }
      // 隔天不開（例如週二晚上、週五晚上、週六晚上），往後找下一個開放日
      let offset = 2;
      while (offset <= 7) {
        const candidateDay = (currentDay + offset) % 7;
        if (OPEN_DAYS.includes(candidateDay)) {
          const nextName = DAY_NAMES[candidateDay];
          return {
            isTomorrowOpen: false,
            nextDayName: nextName,
            pillText: `下一個開放日 ${nextName} 07:30`,
            cardTitlePrefix: `定點站隔日停開・下一個開放日 ${nextName} 07:30`,
            rightBoxLabel: "下一個開放日",
            rightBoxValue: `${nextName} 07:30`,
            navBtnText: (stationName) => `🧭 查看定點站位置 (${stationName}・${nextName} 07:30 開放)`,
            noticeHtml: `
              <div style="background: #FFF7ED; border: 1px solid #FED7AA; border-radius: 12px; padding: 10px 14px; margin-bottom: 10px; font-size: 13px; color: #9A3412; line-height: 1.5;">
                <strong>⚠️ 定點站開放日提醒：</strong> 定點收運站僅每週一、二、四、五 07:30-08:30 開放，<strong>下一個開放日為 ${nextName} 07:30</strong>。<br>
                不想把垃圾堆在家裡苦等？歡迎直接預約下方【生活管家 999 包月到府代倒】！
              </div>
            `
          };
        }
        offset++;
      }
    }

    // 預設台東座標 (鐵花/轉運站)
    let currentLat = 22.7518;
    let currentLon = 121.1475;
    let currentAreaName = "鐵花村 / 轉運站周邊";
    let currentLocMode = 'gps'; // 'gps' 或 'manual'
    let currentTravelMode = 'scooter'; // 創辦人指引：預設台東常民生活首選【🛵 騎機車】！

    // 交通工具動力模型：速度 (公尺/分)、圖示與 Google Maps 導航協議
    const TRAVEL_PROFILES = {
      walking: { name: "步行", speedMpm: 75, icon: "🚶", gmapMode: "walking", desc: "(步行約 4.5km/h)" },
      scooter: { name: "騎車", speedMpm: 500, icon: "🛵", gmapMode: "two-wheeler", desc: "(騎機車約 30km/h)" },
      car:     { name: "開車", speedMpm: 400, icon: "🚗", gmapMode: "driving", desc: "(開車市區含臨停約 24km/h)" }
    };

    function setTravelMode(mode) {
      currentTravelMode = mode;
      document.querySelectorAll('#modeWalkBtn, #modeScooterBtn, #modeCarBtn').forEach(b => b.classList.remove('active'));
      const desc = document.getElementById('travelModeDesc');
      if (mode === 'walking') {
        document.getElementById('modeWalkBtn').classList.add('active');
        desc.innerText = TRAVEL_PROFILES.walking.desc;
      } else if (mode === 'scooter') {
        document.getElementById('modeScooterBtn').classList.add('active');
        desc.innerText = TRAVEL_PROFILES.scooter.desc;
      } else if (mode === 'car') {
        document.getElementById('modeCarBtn').classList.add('active');
        desc.innerText = TRAVEL_PROFILES.car.desc;
      }
      renderRadar();
    }

    // 台東市區主要地標與路段地理詞庫 (包含新站特區、外環聚落與創辦人實測路段)
    const TAITUNG_GEO_DICT = [
      { keywords: ["興航", "興航街", "興安路一段", "興安", "新站特區"], name: "台東市新站特區/興航街", lat: 22.7932, lon: 121.1218 },
      { keywords: ["台東新站", "台東車站", "火車站", "志航路一段", "文昌路"], name: "台東新站/志航路前站", lat: 22.7930, lon: 121.1225 },
      { keywords: ["正氣", "基督教醫院", "夜市", "正氣路"], name: "台東市正氣路商圈", lat: 22.7535, lon: 121.1512 },
      { keywords: ["鐵花", "轉運站", "秀泰", "新生路", "鐵花村"], name: "台東市鐵花村/轉運站", lat: 22.7518, lon: 121.1475 },
      { keywords: ["寶桑", "精誠", "寶桑路"], name: "台東市寶桑路老街", lat: 22.7588, lon: 121.1522 },
      { keywords: ["四維", "強國", "四維路"], name: "台東市四維路一段", lat: 22.7610, lon: 121.1505 },
      { keywords: ["更生", "馬偕", "馬偕醫院", "更生路"], name: "台東市更生路/馬偕醫院", lat: 22.7560, lon: 121.1440 },
      { keywords: ["傳廣", "傳廣路"], name: "台東市傳廣路段", lat: 22.7582, lon: 121.1395 },
      { keywords: ["東海", "漢陽", "中華路二段", "東海運動公園"], name: "台東市中華路二段/東海", lat: 22.7420, lon: 121.1390 },
      { keywords: ["豐榮", "漢中", "豐榮路"], name: "台東市豐榮路/漢中街", lat: 22.7405, lon: 121.1352 },
      { keywords: ["豐年", "康樂", "中興路二段", "中興路三段", "機場"], name: "台東市豐年/康樂機場特區", lat: 22.7630, lon: 121.1180 },
      { keywords: ["大豐", "豐里", "中華路三段", "中華路四段"], name: "台東市大豐/豐里生活圈", lat: 22.7230, lon: 121.1380 },
      { keywords: ["知本", "建興", "青海路", "大學路", "知本車站"], name: "台東市知本/建興生活圈", lat: 22.7050, lon: 121.0580 },
      { keywords: ["富岡", "石川", "松江路", "漁港"], name: "台東市富岡漁港/海線圈", lat: 22.7920, lon: 121.1920 },
      { keywords: ["南王", "卑南", "更生北路", "綠色隧道"], name: "台東市南王/卑南文化區", lat: 22.7820, lon: 121.1180 }
    ];

    function switchLocMode(mode) {
      currentLocMode = mode;
      const tabGps = document.getElementById('tabGpsBtn');
      const tabManual = document.getElementById('tabManualBtn');
      const gpsView = document.getElementById('gpsView');
      const manualView = document.getElementById('manualView');

      if (mode === 'gps') {
        tabGps.classList.add('active');
        tabManual.classList.remove('active');
        gpsView.style.display = 'flex';
        manualView.style.display = 'none';
        requestLocation();
      } else {
        tabManual.classList.add('active');
        tabGps.classList.remove('active');
        gpsView.style.display = 'none';
        manualView.style.display = 'flex';
        const inp = document.getElementById('manualAddressInput');
        inp.focus();
      }
    }

    async function searchManualAddress() {
      const q = document.getElementById('manualAddressInput').value.trim();
      const notice = document.getElementById('manualSearchNotice');
      if (!q) {
        notice.innerText = "⚠️ 請輸入路名或門牌地址！";
        notice.style.color = "#DC2626";
        return;
      }

      notice.innerText = "🔍 正在精準定位中...";
      notice.style.color = "#0284C7";

      let match = TAITUNG_GEO_DICT.find(item => 
        item.keywords.some(kw => q.includes(kw) || kw.includes(q))
      );

      if (match) {
        currentLat = match.lat;
        currentLon = match.lon;
        currentAreaName = match.name;
        notice.innerText = `✅ 已精準定位至【${match.name}】！`;
        notice.style.color = "#059669";
        renderRadar();
        return;
      }

      try {
        const query = q.includes("台東") ? q : `台東縣台東市 ${q}`;
        const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=1&countrycodes=tw`;
        const res = await fetch(url, { headers: { 'Accept-Language': 'zh-TW' } });
        const data = await res.json();
        if (data && data.length > 0) {
          currentLat = parseFloat(data[0].lat);
          currentLon = parseFloat(data[0].lon);
          currentAreaName = q;
          notice.innerText = `✅ 已成功定位至【${q}】！(${currentLat.toFixed(4)}, ${currentLon.toFixed(4)})`;
          notice.style.color = "#059669";
          renderRadar();
          return;
        }
      } catch (e) {
        console.warn("Geocoding fetch error:", e);
      }

      notice.innerText = `⚠️ 找不到「${q}」的確切位置！請確認路名（如：興航街、正氣路），或改點上方【🎯 手機自動定位】`;
      notice.style.color = "#DC2626";
    }

    function initTimeInput() {
      const now = (typeof window !== 'undefined' && window.__TEST_NOW__) ? new Date(window.__TEST_NOW__) : new Date();
      const currentH = now.getHours();
      const currentM = now.getMinutes();
      const timeInput = document.getElementById('trashTimeInput');
      const timeDesc = document.getElementById('timeRelativeDesc');

      if (currentH < 15 || currentH >= 21) {
        timeInput.value = "17:15";
        timeDesc.innerText = "(推薦 17:15 清運時段)";
      } else {
        const hh = String(currentH).padStart(2, '0');
        const mm = String(currentM).padStart(2, '0');
        timeInput.value = `${hh}:${mm}`;
        timeDesc.innerText = "(目前手機時間)";
      }
    }

    function onTimeInputChange() {
      const val = document.getElementById('trashTimeInput').value;
      if (val) {
        document.getElementById('timeRelativeDesc').innerText = `(預計 ${val} 出發)`;
        renderRadar();
      }
    }

    function setNowTime() {
      const now = (typeof window !== 'undefined' && window.__TEST_NOW__) ? new Date(window.__TEST_NOW__) : new Date();
      const hh = String(now.getHours()).padStart(2, '0');
      const mm = String(now.getMinutes()).padStart(2, '0');
      document.getElementById('trashTimeInput').value = `${hh}:${mm}`;
      document.getElementById('timeRelativeDesc').innerText = `(現在 ${hh}:${mm})`;
      renderRadar();
    }

    function quickSetTime(tStr) {
      document.getElementById('trashTimeInput').value = tStr;
      document.getElementById('timeRelativeDesc').innerText = `(指定 ${tStr} 出發)`;
      renderRadar();
    }

    function toggleRecycle(e) {
      if (e.target.id !== 'recycleCheckbox') {
        const cb = document.getElementById('recycleCheckbox');
        cb.checked = !cb.checked;
        onRecycleChange();
      }
    }

    function onRecycleChange() {
      const cb = document.getElementById('recycleCheckbox');
      const box = document.getElementById('recycleBox');
      const sub = document.getElementById('recycleSubText');
      const title = document.getElementById('recycleTitleText');
      if (cb.checked) {
        box.style.borderColor = '#059669';
        box.style.backgroundColor = '#ECFDF5';
        title.style.color = '#065F46';
        sub.innerText = '✅ 已勾選：僅為您篩選【一般垃圾 ＋ 資源回收車】雙收班次！';
      } else {
        box.style.borderColor = '#E2E8F0';
        box.style.backgroundColor = '#F8FAFC';
        title.style.color = 'var(--text-main)';
        sub.innerText = '未勾選默認只倒垃圾；勾選後只顯示【垃圾+回收雙收】車次';
      }
      renderRadar();
    }

